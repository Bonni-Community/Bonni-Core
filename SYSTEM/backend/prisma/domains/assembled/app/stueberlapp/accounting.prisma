/// Immutable accounting movement. Corrections are represented by a new
/// transaction and linked through reversedByTransactionId.
model AccountingTransaction {
  id                      String   @id
  bookingKey              String   @unique
  bookingReference        String   @unique
  memberId                String
  personKey               String?
  type                     String
  status                   String
  sourceType               String
  sourceId                 String?
  invoiceId                String?
  amountInCents            Int
  amountSignedInCents      Int
  description              String?
  createdById              String?
  metadata                 Json?
  reversedByTransactionId  String?
  reversedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([memberId, status])
  @@index([sourceType, sourceId])
  @@index([invoiceId])
  @@index([reversedByTransactionId])
}
