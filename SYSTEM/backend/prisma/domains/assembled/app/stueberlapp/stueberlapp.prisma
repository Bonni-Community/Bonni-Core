  payments PaymentTransaction[]
}

model PaymentTransaction {
  id              String         @id @default(cuid())
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  memberId        String?
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  ledgerEntryId   String?
  ledgerEntry     MemberLedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  financeTransactionId String?
  financeTransaction   FinanceTransaction? @relation(fields: [financeTransactionId], references: [id])
  amount          Decimal
  status          PaymentStatus @default(PENDING)
  externalRef     String?
  note            String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())

  financeSessionEntries FinanceSessionEntry[]
  cashBookEntry CashBookEntry?
}

model Invoice {
  id                  String        @id @default(cuid())
  memberId            String
  invoiceNumber       String        @unique
  periodStart         DateTime?
  periodEnd           DateTime?
  totalAmount         Decimal
  status              InvoiceStatus @default(DRAFT)
  pdfMediaFileId      String?
  snapshotJson        Json?
  snapshotHash        String?
  pdfHash             String?
  previousInvoiceHash String?
  issuedAt            DateTime?
  createdAt           DateTime      @default(now())

  invoiceProcessingState      FinanceProcessingState @default(FREE)
  invoiceProcessingSessionId  String?
  invoiceProcessingSession    FinanceSession? @relation("InvoiceProcessingSession", fields: [invoiceProcessingSessionId], references: [id])
  invoiceProcessingStartedAt  DateTime?
  invoiceProcessingStartedBy  String?
  invoiceProcessingEndedAt    DateTime?
  invoiceProcessingEndedBy    String?

  lines                 InvoiceLine[]
  auditSnapshots        InvoiceAuditSnapshot[]
  payments              PaymentTransaction[]
  financeSessionEntries FinanceSessionEntry[]
}

model Settlement {
  id          String           @id @default(cuid())
  label       String?
  status      SettlementStatus @default(OPEN)
  startedAt   DateTime
  endsAt      DateTime
  closedAt    DateTime?
  closedById  String?
  note        String?

  financeSessions FinanceSession[]
  events          FinanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startedAt, endsAt])
}

model FinanceSession {
  id              String               @id @default(cuid())
  settlementId    String?
  settlement      Settlement?          @relation(fields: [settlementId], references: [id])
  memberId        String?
  memberAccountId String?
  title           String
  type            String               @default("MEMBER_ACCOUNT_CLEARING")
  status          FinanceSessionStatus @default(DRAFT)
  periodStart     DateTime?
  periodEnd       DateTime?
  openedAt        DateTime             @default(now())
  openedById      String?
  readyAt         DateTime?
  invoicedAt      DateTime?
  paidAt          DateTime?
  closedAt        DateTime?
  closedById      String?
  voidedAt        DateTime?
  voidedById      String?
  note            String?

  entries             FinanceSessionEntry[]
  processingInvoices  Invoice[]              @relation("InvoiceProcessingSession")
  tabSessionGroups    TabSessionGroup[]
  events              FinanceEvent[]
  financeTransactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settlementId, status])
  @@index([memberId, status])
  @@index([memberAccountId, status])
  @@index([status, openedAt])
}

model FinanceSessionEntry {
  id               String                    @id @default(cuid())
  financeSessionId String
  financeSession   FinanceSession            @relation(fields: [financeSessionId], references: [id], onDelete: Cascade)

  type             FinanceSessionEntryType
  status           FinanceSessionEntryStatus @default(ACTIVE)

  ledgerEntryId    String?
  ledgerEntry      MemberLedgerEntry?        @relation(fields: [ledgerEntryId], references: [id])
  invoiceId        String?
  invoice          Invoice?                  @relation(fields: [invoiceId], references: [id])
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction?   @relation(fields: [paymentTransactionId], references: [id])

  sourceType       String?
  sourceId         String?
  label            String?
  amount           Decimal?
  note             String?
  addedAt          DateTime                  @default(now())
  addedById        String?
  removedAt        DateTime?
  removedById      String?
  removedReason    String?

  events              FinanceEvent[]
  financeTransactions FinanceTransaction[]

  @@index([financeSessionId, status])
  @@index([type, status])
  @@index([ledgerEntryId, status])
  @@index([invoiceId, status])
  @@index([paymentTransactionId, status])
}

model FinanceEvent {
  id                    String               @id @default(cuid())
  settlementId          String?
  settlement            Settlement?          @relation(fields: [settlementId], references: [id])
  financeSessionId      String?
  financeSession        FinanceSession?      @relation(fields: [financeSessionId], references: [id], onDelete: Cascade)
  financeSessionEntryId String?
  financeSessionEntry   FinanceSessionEntry? @relation(fields: [financeSessionEntryId], references: [id], onDelete: Cascade)

  type            FinanceEventType
  actor           FinanceEventActor
  reason          FinanceEventReason?
  actorAccountId  String?
  occurredAt      DateTime           @default(now())
  sourceType      String?
  sourceId        String?
  note            String?
  payload         Json?

  createdAt       DateTime           @default(now())

  @@index([settlementId, occurredAt])
  @@index([financeSessionId, occurredAt])
  @@index([financeSessionEntryId, occurredAt])
  @@index([type, actor, reason])
  @@index([sourceType, sourceId])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  ledgerEntryId String?
  ledgerEntry   MemberLedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  sourceType    String?
  sourceId      String?
  label         String
  quantity      Decimal?
  unitPrice     Decimal?
  totalPrice    Decimal
}

model InvoiceAuditSnapshot {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  schemaVersion String
  snapshotJson  Json
  hash          String
  previousHash  String?
  createdAt     DateTime @default(now())
}

// -----------------------------------------------------
// EVENTS
// -----------------------------------------------------

model Event {
  id                 String      @id @default(cuid())
  type               String
  title              String
  description        String?
  startAt            DateTime
  endAt              DateTime?
  status             EventStatus @default(DRAFT)
  source             StueberlEventSource @default(LOCAL)
  sourceEventId      String?
  kind               StueberlEventKind @default(SHORT_TERM)
  location           String?
  revision           Int         @default(1)
  organizerId        String?
  createdByAccountId  String?
  updatedByAccountId  String?
  budgetFundId       String?
  accountingPeriodId String?
  maxParticipants    Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  registrations    EventRegistration[]
  contributions    EventContribution[]
  questionnaires   EventQuestionnaire[]
  roomReservations EventRoomReservation[]
  menus            EventMenu[]
  needs            EventNeed[]
  benefitRules     EventBenefitRule[]
  tabSessions      TabSession[]
  tabs             Tab[]

  @@unique([source, sourceEventId])
  @@index([source, status, startAt])
}

model EventRegistration {
  id           String                  @id @default(cuid())
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id])
  memberId     String
  status       EventRegistrationStatus @default(REGISTERED)
  adultCount   Int                     @default(1)
  childCount   Int                     @default(0)
  guestCount   Int                     @default(0)
  note         String?
  registeredAt DateTime                @default(now())

  guests           EventGuest[]
  answers          EventAnswer[]
  seats            EventSeatReservation[]
  mealSelections   EventMealSelection[]
}

model EventGuest {
  id                 String            @id @default(cuid())
  registrationId     String
  registration       EventRegistration @relation(fields: [registrationId], references: [id])
  type               String
  displayName        String?
  age                Int?
  foodPreferenceNote String?
  allergyNote        String?
}

model EventQuestionnaire {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  title   String

  questions EventQuestion[]
}

model EventQuestion {
  id              String             @id @default(cuid())
  questionnaireId String
  questionnaire   EventQuestionnaire @relation(fields: [questionnaireId], references: [id])
  question        String
  type            EventQuestionType
  required        Boolean            @default(false)
  optionsJson     Json?
  sortOrder       Int                @default(0)

  answers EventAnswer[]
}

model EventAnswer {
  id             String            @id @default(cuid())
  questionId     String
  question       EventQuestion     @relation(fields: [questionId], references: [id])
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  answerJson     Json
  createdAt      DateTime          @default(now())
}

model EventContribution {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  memberId String

  type       String
  categoryId String?

  title           String
  normalizedTitle String?
  duplicateKey    String?
  duplicateGroup  String?

  description String?
  quantity    Decimal?

  allowDuplicate     Boolean   @default(true)
  duplicateCheckedAt DateTime?
  duplicateStatus    String? // OK | WARNING | BLOCKED | CONFLICT

  approved            Boolean   @default(false)
  approvedByAccountId String?
  approvedAt          DateTime?

  status     ContributionStatus @default(PLANNED)
  reservedAt DateTime           @default(now())
  note       String?

  @@index([eventId, categoryId])
  @@index([eventId, duplicateKey])
  @@index([eventId, duplicateGroup])
}

model EventNeed {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  type       String
  categoryId String?

  title           String
  normalizedTitle String?
  duplicateGroup  String?

  targetQuantity  Decimal?
  currentQuantity Decimal?
  missingQuantity Decimal?

  requiredQuantity Int?
  allowDuplicates  Boolean @default(true)
  maxDuplicates    Int?

  note String?

  @@index([eventId, categoryId])
  @@index([eventId, duplicateGroup])
}

model EventMenu {
  id               String  @id @default(cuid())
  eventId          String
  event            Event   @relation(fields: [eventId], references: [id])
  productId        String?
  productVersionId String?
  recipeId         String?
  included         Boolean @default(false)
  preOrderRequired Boolean @default(false)
}

model EventMealOption {
  id                   String              @id @default(cuid())
  eventId              String?
  label                String
  description          String?
  productId            String?
  recipeId             String?
  adultSuitable        Boolean             @default(true)
  childSuitable        Boolean             @default(true)
  vegetarian           Boolean             @default(false)
  vegan                Boolean             @default(false)
  allergenSnapshotJson Json?
  maxQuantity          Int?
  sortOrder            Int                 @default(0)

  selections EventMealSelection[]
}

model EventMealSelection {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  mealOptionId   String
  mealOption     EventMealOption   @relation(fields: [mealOptionId], references: [id])
  quantity       Int               @default(1)
  forGuestName   String?
  note           String?

  @@unique([registrationId, mealOptionId, forGuestName])
}

model EventRoomReservation {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  roomId     String
  layoutId   String?
  startAt    DateTime
  endAt      DateTime
  reservedBy String?
  note       String?
}

model EventBenefitRule {
  id                  String               @id @default(cuid())
  eventId             String
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ruleType            EventBenefitRuleType
  productId           String?
  productVersionId    String?
  categoryId          String?
  // NULL bleibt die bisherige kostenlose Benefit-Regel. Ein gesetzter Wert
  // ist ein versionsgebundener Eventpreis in Cent.
  unitPriceCents      Int?
  validFrom           DateTime             @default(now())
  validUntil          DateTime?
  revision            Int                  @default(1)
  source              EventPriceSource     @default(LOCAL)
  maxQuantity         Decimal?
  memberRole          String?
  requiresReservation Boolean              @default(false)
  active              Boolean              @default(true)
  note                String?
  createdByAccountId  String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([eventId, productId, productVersionId, active, validFrom])
}

model EventBenefitUsage {
  id                 String             @id @default(cuid())
  eventBenefitRuleId String
  memberId           String?
  tabItemId          String?
  orderItemId        String?
  quantity           Decimal            @default(1)
  status             BenefitUsageStatus @default(RESERVED)
  usedAt             DateTime?
  createdAt          DateTime           @default(now())
}

model EventMovieOption {
  id        String @id @default(cuid())
  eventId   String
  movieId   String
  movie     Movie  @relation(fields: [movieId], references: [id])
  sortOrder Int    @default(0)

  votes EventMovieVote[]
}

model EventMovieVote {
  id                 String           @id @default(cuid())
  eventMovieOptionId String
  option             EventMovieOption @relation(fields: [eventMovieOptionId], references: [id])
  memberId           String
  vote               MovieVoteType
  createdAt          DateTime         @default(now())

  @@unique([eventMovieOptionId, memberId])
}

model ContributionCategory {
  id String @id @default(cuid())

  key         String  @unique
  label       String
  description String?

  uniqueItems            Boolean @default(false)
  defaultAllowDuplicates Boolean @default(true)

  maxItems               Int?
  duplicateMode          String @default("ALLOW") // ALLOW | WARN | BLOCK | APPROVAL_REQUIRED
  normalizationRulesJson Json?

  createdAt DateTime @default(now())
}

model ContributionPreference {
  id String @id @default(cuid())

  eventId    String
  categoryId String?

  key   String
  label String

  required       Boolean  @default(false)
  targetQuantity Decimal?
  note           String?
}

model ContributionDuplicateRule {
  id String @id @default(cuid())

  eventId    String
  categoryId String?

  duplicateGroup String?
  duplicateKey   String?

  mode           String  @default("WARN") // ALLOW | WARN | BLOCK | APPROVAL_REQUIRED
  maxCount       Int?
  warningMessage String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([eventId, categoryId])
  @@index([eventId, duplicateKey])
  @@index([eventId, duplicateGroup])
}

model ContributionConflict {
  id String @id @default(cuid())

  eventId String

  contributionAId String
  contributionBId String

  reason   String
  severity StueberlLogLevel @default(WARN)
  status   String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | IGNORED

  detectedBy          String?
  resolvedByAccountId String?
  resolvedAt          DateTime?
  resolutionNote      String?

  createdAt DateTime @default(now())

  @@index([eventId, status])
  @@index([contributionAId])
  @@index([contributionBId])
}

model ContributionDuplicateCheck {
  id String @id @default(cuid())

  eventId        String
  contributionId String?

  inputTitle      String
  normalizedTitle String
  duplicateKey    String?
  duplicateGroup  String?

  result      String // OK | WARNING | BLOCKED | APPROVAL_REQUIRED
  matchesJson Json?

  createdAt DateTime @default(now())

  @@index([eventId, duplicateKey])
  @@index([eventId, duplicateGroup])
}

