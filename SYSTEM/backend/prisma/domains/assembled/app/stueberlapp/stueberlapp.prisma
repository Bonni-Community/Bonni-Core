// -----------------------------------------------------
// MEMBER
// -----------------------------------------------------

model EmergencyPolicy {
  id                       String          @id @default(cuid())
  mode                     LocalNodeStatus
  disabledCapabilitiesJson Json
  warningMessage           String
  active                   Boolean         @default(true)
  createdAt                DateTime        @default(now())
}

model EmergencyModuleLock {
  id         String          @id @default(cuid())
  mode       LocalNodeStatus
  module     String
  capability String?
  locked     Boolean         @default(true)
  reason     String?
  createdAt  DateTime        @default(now())
}

model MemberReimbursement {
  id            String              @id @default(cuid())
  memberId      String
  procurementId String
  procurement   Procurement         @relation(fields: [procurementId], references: [id])
  amount        Decimal
  status        ReimbursementStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  paidAt        DateTime?
}

model MemberLedgerEntry {
  id              String            @id @default(cuid())
  memberAccountId String
  direction       LedgerDirection
  category        LedgerCategory
  amount          Decimal
  status          LedgerEntryStatus @default(BOOKED)
  sourceType      String?
  sourceId        String?
  description     String?
  entryHash       String?
  previousHash    String?
  bookedAt        DateTime          @default(now())
  createdById     String?

  invoiceLines          InvoiceLine[]
  paymentTransactions   PaymentTransaction[]
  financeSessionEntries FinanceSessionEntry[]

  @@index([memberAccountId, bookedAt])
  @@index([sourceType, sourceId])
}

model MemberLedgerReservation {
  id              String                  @id @default(cuid())
  memberAccountId String
  amount          Decimal
  sourceType      String
  sourceId        String
  status          LedgerReservationStatus @default(RESERVED)
  reservedAt      DateTime                @default(now())
  expiresAt       DateTime?
  committedAt     DateTime?
  releasedAt      DateTime?
}

model MembershipFee {
  id         String     @id @default(cuid())
  key        String     @unique
  label      String
  amount     Decimal
  periodType PeriodType
  active     Boolean    @default(true)
}

model MembershipFeeRun {
  id              String   @id @default(cuid())
  membershipFeeId String
  periodStart     DateTime
  periodEnd       DateTime
  status          String
  createdAt       DateTime @default(now())
  resultJson      Json?
}

// -----------------------------------------------------
// BIERDECKEL / TAB SYSTEM v7
// -----------------------------------------------------
// Fachlicher Schnitt:
// - TabSession = Tagesdeckel / Verantwortung bis 24:00 Uhr.
// - TabSessionGroup = 14-Tage-Sammel-, Übernahme- und Abrechnungsgruppe.
// - TabGroup = gemeinsame Bestellung / Klammer.
// - Tab = einzelner angeschriebener Verzehr / operative Einheit.
// - TabServiceArea trennt Küche, Bar, Geräte und Service.
// - TabService sagt, ob der Tab bestellt, in Bearbeitung, ausgeliefert oder storniert ist.
// - TabAssumption ist eine spätere Übernahme, aber keine Zahlung.
//
// Die alten Tabellen Tab/TabItem liegen isoliert in bierdeckel_legacy.prisma
// als LegacyTab/LegacyTabItem und können später entfernt werden.
// Das neue Prisma-Modell Tab wird bewusst auf die neue Tabelle TabNew gemappt,
// damit die alte Tabelle Tab während der Migration unverändert bleiben kann.
// -----------------------------------------------------

model TabSessionGroup {
  id                  String                @id @default(cuid())
  responsibleMemberId String?
  label               String?
  status              TabSessionGroupStatus @default(COLLECTING)
  startedAt           DateTime              @default(now())
  cutoffAt            DateTime?
  preparedForBookingAt DateTime?
  financeSessionId       String?
  financeSession         FinanceSession?           @relation(fields: [financeSessionId], references: [id])
  closedAt            DateTime?
  createdByAccountId  String?
  note                String?

  entries             TabSessionGroupEntry[]
  assumptionsAsTarget TabAssumption[]       @relation("TabAssumptionTargetGroup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsibleMemberId, status])
  @@index([status, cutoffAt])
}

model TabSessionGroupEntry {
  id                String                     @id @default(cuid())
  tabSessionGroupId String
  tabSessionGroup   TabSessionGroup            @relation(fields: [tabSessionGroupId], references: [id], onDelete: Cascade)
  tabSessionId      String
  tabSession        TabSession                 @relation(fields: [tabSessionId], references: [id], onDelete: Cascade)
  status            TabSessionGroupEntryStatus @default(ACTIVE)
  reason            String?
  addedAt           DateTime                   @default(now())
  addedByAccountId  String?
  removedAt         DateTime?
  removedByAccountId String?
  note              String?

  @@unique([tabSessionGroupId, tabSessionId])
  @@index([tabSessionId, status])
}

model TabSession {
  dailySequence Int @default(0)
  id                 String           @id @default(cuid())
  memberId           String
  eventId            String?
  event              Event?           @relation(fields: [eventId], references: [id])
  businessDate       DateTime
  status             TabSessionStatus @default(OPEN)
  startedAt          DateTime         @default(now())
  endsAt             DateTime
  lockedAt           DateTime?
  closedAt           DateTime?
  totalAmount        Decimal          @default(0)
  createdByAccountId String?
  openedByTerminalId String?
  note               String?

  groupEntries        TabSessionGroupEntry[]
  assignments         TabAssignment[]
  assumptionsAsSource TabAssumption[] @relation("TabAssumptionSourceSession")
  assumptionsAsTarget TabAssumption[] @relation("TabAssumptionTargetSession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, businessDate, dailySequence])
  @@index([memberId, status])
  @@index([businessDate, status])
  @@index([eventId, businessDate, status])
}

model TabOrder {
  id                 String   @id @default(cuid())
  label              String?
  orderedAt          DateTime @default(now())
  createdByAccountId String?
  note               String?

  groups TabGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TabEvent {
  id                 String       @id @default(cuid())
  eventType          TabEventType @default(ORDERED)
  occurredAt         DateTime     @default(now())
  createdByAccountId String?
  terminalId         String?
  note               String?

  groups TabGroup[]
  tabs   Tab[]

  createdAt DateTime @default(now())
}

model TabGroup {
  id                 String   @id @default(cuid())
  clientOrderId      String?  @unique
  orderRequestHash   String?
  orderActorAccountId String?
  orderResponse      Json?
  orderCompletedAt   DateTime?
  tabOrderId         String?
  tabOrder           TabOrder? @relation(fields: [tabOrderId], references: [id])
  tabEventId         String?
  tabEvent           TabEvent? @relation(fields: [tabEventId], references: [id])
  tabLocationId      String?
  tabLocation        TabLocation? @relation(fields: [tabLocationId], references: [id])
  label              String?
  note               String?
  createdByAccountId String?
  createdAt          DateTime @default(now())

  tabs Tab[]

  @@index([tabOrderId])
  @@index([tabEventId])
  @@index([tabLocationId])
}

model TabLocation {
  id        String          @id @default(cuid())
  type      TabLocationType @default(OTHER)
  label     String
  parentId  String?
  parent    TabLocation?    @relation("TabLocationTree", fields: [parentId], references: [id])
  children  TabLocation[]   @relation("TabLocationTree")
  active    Boolean         @default(true)
  note      String?

  seats  TabSeat[]
  groups TabGroup[]
  tabs   Tab[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, label])
  @@index([type, active])
}

model TabSeat {
  id            String      @id @default(cuid())
  tabLocationId String
  tabLocation   TabLocation @relation(fields: [tabLocationId], references: [id], onDelete: Cascade)
  label         String
  position      Int?
  active        Boolean     @default(true)
  note          String?

  tabs Tab[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tabLocationId, label])
  @@index([tabLocationId, active])
}

model Tab {
  id                 String            @id @default(cuid())
  tabGroupId         String
  tabGroup           TabGroup          @relation(fields: [tabGroupId], references: [id], onDelete: Cascade)
  tabEventId         String?
  tabEvent           TabEvent?         @relation(fields: [tabEventId], references: [id])
  tabLocationId      String?
  tabLocation        TabLocation?      @relation(fields: [tabLocationId], references: [id])
  tabSeatId          String?
  tabSeat            TabSeat?          @relation(fields: [tabSeatId], references: [id])
  eventId            String?
  event              Event?            @relation(fields: [eventId], references: [id])

  serviceArea        TabServiceArea
  status             TabStatus         @default(ACTIVE)
  productId          String
  productVersionId   String?
  quantity           Decimal
  unitPrice          Decimal
  totalPrice         Decimal
  originalUnitPrice  Decimal?
  source             ReservationSource?
  priceSnapshotJson  Json?
  scheduledFor       DateTime?
  note               String?
  cancelledAt        DateTime?
  cancelledByAccountId String?
  cancellationReason String?
  createdByTerminalId String?
  createdByAccountId  String?
  createdAt          DateTime          @default(now())

  service     TabService?
  assignments TabAssignment[]
  assumptionsAsSource TabAssumption[] @relation("TabAssumptionSourceTab")
  stockReferences TabStockReference[]
  depositReferences TabDepositReference[]

  @@index([tabGroupId, status])
  @@index([serviceArea, status])
  @@index([productId, createdAt])
  @@index([eventId, createdAt])
  @@index([tabLocationId, tabSeatId])
  @@map("TabNew")
}

model TabService {
  id             String           @id @default(cuid())
  tabId          String           @unique
  tab            Tab              @relation(fields: [tabId], references: [id], onDelete: Cascade)
  serviceType    TabServiceType   @default(NORMAL)
  serviceStatus  TabServiceStatus @default(ORDERED)
  orderedAt      DateTime         @default(now())
  startedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  scheduledFor   DateTime?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceType, serviceStatus])
  @@index([scheduledFor, serviceStatus])
}

model TabAssignment {
  id                 String              @id @default(cuid())
  tabId              String
  tab                Tab                 @relation(fields: [tabId], references: [id], onDelete: Cascade)
  tabSessionId       String
  tabSession         TabSession          @relation(fields: [tabSessionId], references: [id], onDelete: Cascade)
  status             TabAssignmentStatus @default(ACTIVE)
  quantity           Decimal?
  amount             Decimal?
  assignedAt         DateTime            @default(now())
  assignedByAccountId String?
  removedAt          DateTime?
  removedByAccountId String?
  note               String?

  @@index([tabSessionId, status])
  @@index([tabId, status])
}

model TabAssumption {
  id                      String              @id @default(cuid())
  mode                    TabAssumptionMode   @default(FULL)
  status                  TabAssumptionStatus @default(ACTIVE)
  sourceTabSessionId      String?
  sourceTabSession        TabSession?         @relation("TabAssumptionSourceSession", fields: [sourceTabSessionId], references: [id])
  targetTabSessionId      String?
  targetTabSession        TabSession?         @relation("TabAssumptionTargetSession", fields: [targetTabSessionId], references: [id])
  targetTabSessionGroupId String?
  targetTabSessionGroup   TabSessionGroup?    @relation("TabAssumptionTargetGroup", fields: [targetTabSessionGroupId], references: [id])
  sourceTabId             String?
  sourceTab               Tab?                @relation("TabAssumptionSourceTab", fields: [sourceTabId], references: [id])
  amount                  Decimal?
  quantity                Decimal?
  reason                  String?
  assumedAt               DateTime            @default(now())
  assumedByAccountId      String?
  settledAt               DateTime?
  cancelledAt             DateTime?
  note                    String?

  @@index([sourceTabSessionId, status])
  @@index([targetTabSessionId, status])
  @@index([targetTabSessionGroupId, status])
  @@index([sourceTabId, status])
}

model TabStockReference {
  id                 String   @id @default(cuid())
  tabId              String
  tab                Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  referenceType      String
  referenceId        String?
  quantity           Decimal?
  source             String?
  createdByAccountId String?
  createdAt          DateTime @default(now())

  @@index([tabId])
  @@index([referenceType, referenceId])
}

model TabDepositReference {
  id                 String   @id @default(cuid())
  tabId              String
  tab                Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  referenceType      String
  referenceId        String?
  depositTypeId      String?
  quantity           Decimal?
  amount             Decimal?
  createdByAccountId String?
  createdAt          DateTime @default(now())

  @@index([tabId])
  @@index([referenceType, referenceId])
  @@index([depositTypeId])
}


model Table {
  id       String  @id @default(cuid())
  name     String
  capacity Int?
  roomId   String?
  active   Boolean @default(true)

  seats    TableSeat[]
}

model TableSeat {
  id String @id @default(cuid())

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  label    String
  position Int?
  active   Boolean @default(true)

  orders Order[]

  @@unique([tableId, label])
}

// -----------------------------------------------------
// ORDERS / TABLE / KITCHEN
// -----------------------------------------------------

model Order {
  id               String      @id @default(cuid())
  memberId         String?
  tableId          String?
  eventId          String?
  status           OrderStatus @default(DRAFT)
  sourceTerminalId String?

  tableSessionId String?
  tableSeatId    String?
  tableSeat      TableSeat?    @relation(fields: [tableSeatId], references: [id])
  orderGroupId   String?
  orderGroup     OrderGroup?   @relation(fields: [orderGroupId], references: [id])

  orderSequence   Int?
  roundNumber     Int?
  priority        Priority?
  kitchenSequence Int?
  barSequence     Int?
  printSequence   Int?

  orderedAt         DateTime  @default(now())
  acceptedAt        DateTime?
  preparedAt        DateTime?
  servedAt          DateTime?
  servedByAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([tableSessionId, orderSequence])
  @@index([sourceTerminalId, orderedAt])
  @@index([kitchenSequence])
  @@index([barSequence])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  productVersionId String?
  quantity         Decimal
  note             String?
  status           String  @default("NEW")
}

model PreOrder {
  id        String      @id @default(cuid())
  memberId  String
  eventId   String?
  desiredAt DateTime?
  status    OrderStatus @default(SUBMITTED)
  note      String?
  createdAt DateTime    @default(now())

  items PreOrderItem[]
}

model PreOrderItem {
  id               String   @id @default(cuid())
  preOrderId       String
  preOrder         PreOrder @relation(fields: [preOrderId], references: [id])
  productId        String
  productVersionId String?
  quantity         Decimal
  note             String?
  status           String   @default("NEW")
}

model PreOrderDemand {
  id                String   @id @default(cuid())
  preOrderId        String?
  stockItemId       String
  requiredQuantity  Decimal
  availableQuantity Decimal?
  missingQuantity   Decimal?
  createdAt         DateTime @default(now())
}

model Seat {
  id                   String     @id @default(cuid())
  roomId               String
  room                 Room       @relation(fields: [roomId], references: [id])
  label                String
  row                  String?
  x                    Int?
  y                    Int?
  wheelchairAccessible Boolean    @default(false)
  status               SeatStatus @default(AVAILABLE)

  reservations EventSeatReservation[]
}

model EventSeatReservation {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  seatId         String
  seat           Seat              @relation(fields: [seatId], references: [id])

  @@unique([seatId, registrationId])
}

model OrderGroup {
  id               String       @id @default(cuid())
  tableSessionId   String
  roundNumber      Int
  label            String?
  sourceTerminalId String?
  startedAt        DateTime     @default(now())
  closedAt         DateTime?

  orders Order[]

  @@unique([tableSessionId, roundNumber])
}

