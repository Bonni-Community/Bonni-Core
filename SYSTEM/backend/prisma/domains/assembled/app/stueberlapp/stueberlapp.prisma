model OperationParticipant {
  id               String    @id @default(cuid())
  operationId      String
  operation        Operation @relation(fields: [operationId], references: [id])
  memberId         String
  role             String?
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  attendanceStatus String?
}

model OperationResourceUsage {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id])
  stockItemId String
  quantity    Decimal
  note        String?
}

model Asset {
  id                String  @id @default(cuid())
  type              String
  name              String
  inventoryNumber   String?
  maintenanceStatus String?

  usages OperationAssetUsage[]
}

model OperationAssetUsage {
  operationId String
  assetId     String

  operation Operation @relation(fields: [operationId], references: [id])
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@id([operationId, assetId])
}

model OperationReport {
  id             String    @id @default(cuid())
  operationId    String
  operation      Operation @relation(fields: [operationId], references: [id])
  summary        String?
  issues         String?
  lessonsLearned String?
  createdAt      DateTime  @default(now())
}

model BorrowableItem {
  id            String   @id @default(cuid())
  name          String
  type          String
  stockItemId   String?
  serialNumber  String?
  depositAmount Decimal?
  active        Boolean  @default(true)

  loans Loan[]
}

model Tenant {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  environments TenantEnvironment[]
}

model TenantEnvironment {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  type        EnvironmentType
  key         String
  name        String
  databaseUrl String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@unique([tenantId, type, key])
}

model SandboxMapping {
  id             String   @id @default(cuid())
  productionType String
  productionId   String
  sandboxType    String
  sandboxId      String
  createdAt      DateTime @default(now())

  @@index([productionType, productionId])
  @@index([sandboxType, sandboxId])
}

model WorkerProfile {
  id          String   @id @default(cuid())
  personId    String?
  displayName String
  active      Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pins  WorkerPin[]
}

model WorkerPin {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id])
  pinHash         String
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  revokedAt       DateTime?
}

model LayoutPreset {
  id           String        @id @default(cuid())
  key          String        @unique
  label        String
  terminalType String?
  configJson   Json?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
}

model PriceList {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean   @default(true)

  items PriceListItem[]
}

model PriceListItem {
  id               String    @id @default(cuid())
  priceListId      String
  priceList        PriceList @relation(fields: [priceListId], references: [id])
  productId        String?
  productVersionId String?
  productVariantId String?
  price            Decimal
  note             String?

  @@index([productId])
  @@index([productVersionId])
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  description String?
  durationMin Int?
  ageRating   String?
  mediaFileId String?
  createdAt   DateTime @default(now())

  eventOptions EventMovieOption[]
}

model InfrastructureNode {
  id           String    @id @default(cuid())
  key          String    @unique
  name         String
  type         String
  location     String?
  status       String?
  lastSeenAt   DateTime?
  metadataJson Json?
  createdAt    DateTime  @default(now())

  services InfrastructureService[]
}

model InfrastructureService {
  id            String             @id @default(cuid())
  nodeId        String
  node          InfrastructureNode @relation(fields: [nodeId], references: [id])
  key           String
  name          String
  status        String?
  endpoint      String?
  lastCheckedAt DateTime?

  checks ServiceHealthCheck[]

  @@unique([nodeId, key])
}

model ServiceHealthCheck {
  id        String                @id @default(cuid())
  serviceId String
  service   InfrastructureService @relation(fields: [serviceId], references: [id])
  status    String
  latencyMs Int?
  message   String?
  checkedAt DateTime              @default(now())
}

model CashShiftReport {
  id               String   @id @default(cuid())
  shiftId          String?
  cashDrawerId     String?
  expectedAmount   Decimal?
  countedAmount    Decimal?
  differenceAmount Decimal?
  reportJson       Json?
  createdById      String?
  createdAt        DateTime @default(now())
}

model Device {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String
  active    Boolean  @default(true)
  ipAddress String?
  note      String?
  roomId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room? @relation(fields: [roomId], references: [id])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
