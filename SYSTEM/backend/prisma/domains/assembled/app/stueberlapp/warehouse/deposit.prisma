// =====================================================
// MODULE: STUEBERLAPP / WAREHOUSE / DEPOSIT
// =====================================================
// DepositProduct = Pfandobjekt mit Pfandwert und Rückgabe-Logik.
//
// DepositProduct ist eine eigene Welt neben Product und Article:
// - Product wird verkauft.
// - Article wird intern verwendet/verarbeitet/verbraucht.
// - DepositProduct ist Pfand / Rückgabeobjekt.
//
// DepositStock = berechneter Systembestand.
// DepositTransaction = Pfandvorgang / Wahrheit der Ereignisse.
// DepositCalculation = Rechenweg zu DepositStock.
// =====================================================

enum DepositProductType {
  BOTTLE
  CRATE
  CUP
  TOKEN
  BARREL
  CO2_BOTTLE
  CONTAINER
  OTHER
}

enum DepositTransactionType {
  PURCHASE_IN
  CUSTOMER_CHARGE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  LOSS
  CORRECTION
  INVENTORY_CORRECTION
  REVERSAL
}

enum DepositTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum DepositTransactionDirection {
  IN
  OUT
}

enum DepositStockState {
  IN_HOUSE
  WITH_CUSTOMER
  WITH_SUPPLIER
  LOST
  DIFFERENCE
}

enum DepositCalculationType {
  STOCK_RECALCULATION
  VALUE_RECALCULATION
  INVENTORY_RECONCILIATION
}

model DepositType {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  defaultAmount Decimal?
  active        Boolean  @default(true)

  // Bestehende Kompatibilität: ProductDeposit/PackagingNode können weiter darauf zeigen.
  productDeposits ProductDeposit[]
  packagingNodes  PackagingNode[]

  depositProducts DepositProduct[]
}

model DepositProduct {
  id        String             @id @default(cuid())
  sku       String             @unique
  name      String
  type      DepositProductType @default(OTHER)
  depositTypeId String?
  depositType   DepositType?   @relation(fields: [depositTypeId], references: [id])

  valueCents Int
  currency   String @default("EUR")
  active     Boolean @default(true)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks       DepositStock[]
  transactions DepositTransaction[]
  calculations DepositCalculation[]
  stockReasonEntries StockReasonEntry[]

  inventoryScopes      InventoryScope[]
  inventorySnapshots   InventorySnapshot[]
  inventoryStocks      InventoryStock[]
  inventoryDifferences InventoryDifference[]
  inventoryCorrections InventoryCorrection[]

  conversionInputs  ConversionInput[]  @relation("ConversionInputDepositProduct")
  conversionOutputs ConversionOutput[] @relation("ConversionOutputDepositProduct")

  @@index([type])
  @@index([depositTypeId])
}

model DepositStock {
  id String @id @default(cuid())
  depositProductId String
  depositProduct DepositProduct @relation(fields: [depositProductId], references: [id])

  state DepositStockState @default(IN_HOUSE)
  locationId String?

  quantity Decimal @default(0) @db.Decimal(14, 4)
  valueCents Int @default(0)
  currency String @default("EUR")

  calculationId String?
  lastCalculatedAt DateTime?
  updatedAt DateTime @updatedAt

  @@unique([depositProductId, state, locationId])
  @@index([state])
  @@index([locationId])
}

model DepositTransaction {
  id String @id @default(cuid())
  depositProductId String
  depositProduct DepositProduct @relation(fields: [depositProductId], references: [id])

  type DepositTransactionType
  direction DepositTransactionDirection
  status DepositTransactionStatus @default(POSTED)
  stateFrom DepositStockState?
  stateTo DepositStockState?

  quantity Decimal @db.Decimal(14, 4)
  unitValueCents Int?
  totalValueCents Int?
  currency String @default("EUR")

  productTransactionId String?
  articleTransactionId String?
  financeTransactionId String?
  conversionTransactionId String?
  conversionTransaction   ConversionTransaction? @relation("ConversionDepositTransactions", fields: [conversionTransactionId], references: [id])
  sourceModule String?
  sourceType String?
  sourceId String?
  reason String?
  note String?

  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  createdByAccountId String?

  stockReasonEntries StockReasonEntry[]

  @@index([depositProductId, occurredAt])
  @@index([type])
  @@index([conversionTransactionId])
  @@index([sourceModule, sourceType, sourceId])
}

model DepositCalculation {
  id String @id @default(cuid())
  depositProductId String
  depositProduct DepositProduct @relation(fields: [depositProductId], references: [id])

  type DepositCalculationType
  fromAt DateTime?
  toAt DateTime?

  calculatedQuantity Decimal? @db.Decimal(14, 4)
  calculatedValueCents Int?
  currency String @default("EUR")

  basisJson Json?
  note String?
  calculatedAt DateTime @default(now())
  createdByAccountId String?

  @@index([depositProductId, calculatedAt])
  @@index([type])
}
