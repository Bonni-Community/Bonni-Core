// =====================================================
// MODULE: STUEBERLAPP / WAREHOUSE / ARTIKEL
// =====================================================
// Artikel, ArticleStock/ArticleTransaction, Lieferanten, Einkauf/Beschaffung, Einkaufsvorschläge und Beschaffungsfonds.
//
// V2-Begriffe:
// - Article = intern, geöffnet, verarbeitet, verbraucht; nicht direkt verkauft.
// - ArticleStock = aktueller berechneter Systembestand.
// - ArticleTransaction = fachlicher Artikelvorgang / Wahrheit der Ereignisse.
// - ArticleCalculation = Rechenweg aus ArticleTransactions.
//
// Alte unspezifische Sammelbegriffe werden im aktiven Schema nicht mehr verwendet.
//
// Hinweis: Diese Datei enthält die fachlich zugehörigen
// Enums und Modelle zusammen. Die Datenbankstruktur wurde
// nicht fachlich verändert; das große stueberlapp.prisma
// wurde nur organisatorisch aufgeteilt.
// =====================================================

enum ProcurementType {
  PURCHASE
  DONATION
  SPONSORING
  PRIVATE_ADVANCE
}

enum ArticleType {
  INGREDIENT
  CONSUMABLE
  PACKAGING
  DEVICE
  TOOL
  OPENED_PRODUCT
  COMPONENT
  ACCESSORY
  OTHER
}

enum ArticleTransactionType {
  CREATE_FROM_PRODUCT
  CONSUME_FOR_PRODUCT
  CONSUME_INTERNAL
  PURCHASE
  TRANSFER
  PACK_IN_BOX
  UNPACK_FROM_BOX
  WASTE
  CORRECTION
  INVENTORY_CORRECTION
  REVERSAL
}

enum ArticleTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum ArticleTransactionDirection {
  IN
  OUT
}

enum ArticleCalculationType {
  STOCK_RECALCULATION
  VALUE_RECALCULATION
  COST_ALLOCATION
  INVENTORY_RECONCILIATION
}


// =====================================================
// Artikelbezogene Container-/Hüllenstruktur
// =====================================================
//
// ProductContainer bleibt bewusst bei Artikel: Es beschreibt
// die Hülle/Füllstandslogik eines Artikels, z. B. voll, teilweise
// voll oder leer. Die neue Container-Struktur in container.prisma
// beschreibt dagegen eigenständige Container-Stammdaten.

enum ProductContainerType {
  BOTTLE
  CRATE
  TRAY
  PALLET
}

enum ProductContainerStatus {
  FULL
  PARTIAL
  EMPTY
}

// =====================================================
//   ** model ContainerUsage 
// =====================================================

model ProductContainer {
  id String @id @default(cuid())

  productId        String
  productVersionId String?

  type   ProductContainerType
  status ProductContainerStatus @default(FULL)

  capacity              Int
  currentFilledQuantity Int @default(0)
  currentEmptyQuantity  Int @default(0)

  hasDeposit Boolean @default(false)

  bottleDepositInCents Int @default(0)
  crateDepositInCents  Int @default(0)

  isReturnable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([status])
}

// =====================================================
// 
// =====================================================


model Article {
  id          String      @id @default(cuid())
  sku         String      @unique
  type        ArticleType @default(OTHER)
  name        String
  description String?
  baseUnitId  String?
  category    String?
  active      Boolean     @default(true)
  isStockTracked Boolean  @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime @updatedAt

  variants      ArticleVariant[]
  supplierLinks SupplierArticle[]

  stock        ArticleStock?
  transactions ArticleTransaction[]
  calculations ArticleCalculation[]
  metrics      ArticleMetrics[]
  stockReasonEntries StockReasonEntry[]

  inventoryScopes      InventoryScope[]
  inventorySnapshots   InventorySnapshot[]
  inventoryStocks      InventoryStock[]
  inventoryDifferences InventoryDifference[]
  inventoryCorrections InventoryCorrection[]

  conversionInputs  ConversionInput[]  @relation("ConversionInputArticle")
  conversionOutputs ConversionOutput[] @relation("ConversionOutputArticle")

  @@index([type])
  @@index([active])
}

model ArticleVariant {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id])
  name          String
  barcode       String?
  packageTypeId String?
  quantity      Decimal?
  unitId        String?
  active        Boolean  @default(true)

  @@index([barcode])
}

// =====================================================
// ARTICLE STOCK / TRANSACTIONS / CALCULATIONS
// =====================================================

model ArticleStock {
  id               String   @id @default(cuid())
  articleId        String   @unique
  article          Article  @relation(fields: [articleId], references: [id])
  articleVariantId String?

  quantity         Decimal  @default(0) @db.Decimal(14, 4)
  unitId           String?
  valueCents       Int      @default(0)
  currency         String   @default("EUR")

  calculationId    String?
  lastCalculatedAt DateTime?
  updatedAt        DateTime @updatedAt

  @@index([articleVariantId])
}

model ArticleTransaction {
  id                 String                    @id @default(cuid())
  articleId           String
  article             Article                   @relation(fields: [articleId], references: [id])
  articleVariantId    String?

  type               ArticleTransactionType
  direction          ArticleTransactionDirection
  status             ArticleTransactionStatus @default(POSTED)

  quantity           Decimal                  @db.Decimal(14, 4)
  unitId             String?
  unitValueCents     Int?
  totalValueCents    Int?
  currency           String                   @default("EUR")

  productTransactionId String?
  depositTransactionId String?
  financeTransactionId String?
  conversionTransactionId String?
  conversionTransaction   ConversionTransaction? @relation("ConversionArticleTransactions", fields: [conversionTransactionId], references: [id])
  sourceModule        String?
  sourceType          String?
  sourceId            String?
  reason              String?
  note                String?

  occurredAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  createdByAccountId  String?

  stockReasonEntries StockReasonEntry[]

  @@index([articleId, occurredAt])
  @@index([type])
  @@index([conversionTransactionId])
  @@index([sourceModule, sourceType, sourceId])
}

model ArticleCalculation {
  id             String                 @id @default(cuid())
  articleId      String
  article        Article                @relation(fields: [articleId], references: [id])

  type           ArticleCalculationType
  fromAt         DateTime?
  toAt           DateTime?

  calculatedQuantity Decimal?           @db.Decimal(14, 4)
  calculatedValueCents Int?
  currency       String                 @default("EUR")

  basisJson      Json?
  note           String?
  calculatedAt   DateTime               @default(now())
  createdByAccountId String?

  @@index([articleId, calculatedAt])
  @@index([type])
}

model ArticleMetrics {
  id                String   @id @default(cuid())
  articleId          String
  article            Article  @relation(fields: [articleId], references: [id])

  periodType         ForecastPeriodType?
  periodStart        DateTime?
  periodEnd          DateTime?

  stockQuantity      Decimal? @db.Decimal(14, 4)
  stockValueCents    Int?
  averageCostCents   Int?
  consumedQuantity   Decimal? @db.Decimal(14, 4)
  consumptionValueCents Int?
  lowStockWarning    Boolean  @default(false)
  metricsJson        Json?

  calculatedAt       DateTime @default(now())

  @@index([articleId, calculatedAt])
  @@index([periodType, periodStart, periodEnd])
}

model SupplierArticle {
  id                String   @id @default(cuid())
  supplierId        String
  articleId         String
  articleVariantId  String?
  article           Article  @relation(fields: [articleId], references: [id])
  supplierSku       String?
  supplierName      String?
  purchaseUnitId    String?
  packageTypeId     String?
  unitsPerPackage   Decimal?
  lastPurchasePrice Decimal?
  active            Boolean  @default(true)
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  contact String?
  email   String?
  phone   String?
  active  Boolean @default(true)

  procurements Procurement[]
}

model Procurement {
  id                  String          @id @default(cuid())
  type                ProcurementType
  supplierId          String?
  supplier            Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchasedByMemberId String?
  sponsoredByMemberId String?
  paidFromFundId      String?
  invoiceNumber       String?
  receiptMediaFileId  String?
  totalAmount         Decimal?
  status              String
  purchasedAt         DateTime?
  note                String?
  createdAt           DateTime        @default(now())

  items          ProcurementItem[]
  reimbursements MemberReimbursement[]
  sponsorships   SponsorshipRecord[]

  @@index([supplierId])
}

model ProcurementItem {
  id               String      @id @default(cuid())
  procurementId    String
  procurement      Procurement @relation(fields: [procurementId], references: [id])

  // Einkauf kann direkt ein Product auffüllen oder einen Article beschaffen.
  // Keine allgemeine Bestands-ID mehr: fachliche Zuordnung über Product/Article.
  productId        String?
  articleId        String?
  articleVariantId String?

  quantity         Decimal
  unitPrice        Decimal?
  totalPrice       Decimal?
  expiryDate       DateTime?
  batchNumber      String?
  packageTypeId    String?

  @@index([productId])
  @@index([articleId])
}

model SponsorshipRecord {
  id                   String      @id @default(cuid())
  memberId             String
  procurementId        String
  procurement          Procurement @relation(fields: [procurementId], references: [id])
  estimatedValue       Decimal?
  publicMentionAllowed Boolean     @default(false)
  note                 String?
  createdAt            DateTime    @default(now())
}

model PurchaseSuggestion {
  id          String             @id @default(cuid())
  periodType  ForecastPeriodType
  periodStart DateTime
  periodEnd   DateTime
  status      String             @default("OPEN")
  createdBy   String?
  createdAt   DateTime           @default(now())

  items PurchaseSuggestionItem[]
}

model PurchaseSuggestionItem {
  id                       String             @id @default(cuid())
  suggestionId             String
  suggestion               PurchaseSuggestion @relation(fields: [suggestionId], references: [id])
  productId                String?
  articleId                String?
  articleVariantId         String?
  soldQuantity             Decimal?
  currentStock             Decimal?
  averageConsumption       Decimal?
  suggestedOrderQuantity   Decimal
  suggestedPackageQuantity Decimal?
  packageTypeId            String?
  priority                 Priority           @default(NORMAL)
  reason                   String?
}

model KnowledgeArticle {
  id         String   @id @default(cuid())
  title      String
  content    String
  category   String?
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcurementFund {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  balance   Decimal  @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
