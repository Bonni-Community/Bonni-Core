// =====================================================
// MODULE: STUEBERLAPP / WAREHOUSE / CONTAINER
// =====================================================
// Neue Container-Struktur:
// - ContainerElement beschreibt den Grundgegenstand, z. B. Kiste, Flasche, Dose.
// - ContainerVersion beschreibt Markt-/Bauversionen dieses Elements.
// - ContainerContent beschreibt, was und wie viel hineinpasst.
// - ContainerModule beschreibt die fachliche Verwendung, z. B. Bier, Wein, Speisen.
//
// ProductContainer bleibt bewusst bei Artikel und wird hier nicht gelöscht.
// Bestehende Container/ContainerVersion-Verbindungen bleiben kompatibel.
// =====================================================


enum ContainerType {
  BOTTLE
  CRATE
  CARTON
  PACKAGING
  PALLET
  OTHER
}

enum ContainerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContainerContentType {
  PRODUCT
  CONTAINER
}

enum ContainerContentUnit {
  PIECE
  BOTTLE
  CAN
  CRATE
  CARTON
  PACKAGING
  PALLET
  OTHER
}

enum ContainerContentPriceMode {
  PER_UNIT
  TOTAL_CONTAINER
}

enum ContainerDepositType {
  DEPOSIT
  CAUTION
  REPLACEMENT_VALUE
  CLEANING_FEE
  OTHER
}

enum ContainerCondition {
  NEW
  USED
  DAMAGED
  BROKEN
  DIRTY
  LOST
  RETIRED
}

enum ContainerFillState {
  FULL
  PARTIAL
  EMPTY
}

// -----------------------------------------------------
// Container-Grundelemente und fachliche Module
// -----------------------------------------------------

model ContainerElement {
  id String @id @default(cuid())

  key         String          @unique
  label       String
  description String?
  type        ContainerType?
  status      ContainerStatus @default(ACTIVE)
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ContainerVersion[]
  contentsAsElement ContainerContent[] @relation("ContainerContentElement")

  @@index([status])
  @@index([type])
  @@index([sortOrder])
}

model ContainerUsage {
  id String @id @default(cuid())

  key         String          @unique
  label       String
  description String?
  status      ContainerStatus @default(ACTIVE)
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules ContainerModuleUsage[]

  @@index([status])
  @@index([sortOrder])
}

model ContainerModule {
  id String @id @default(cuid())

  containerVersionId String
  containerVersion   ContainerVersion @relation(fields: [containerVersionId], references: [id], onDelete: Cascade)

  name        String
  shortName   String?
  description String?
  status      ContainerStatus @default(ACTIVE)
  sortOrder   Int             @default(0)

  cooledRequired  Boolean @default(false)
  foodSafe        Boolean @default(false)
  minTemperature  Decimal?
  maxTemperature  Decimal?
  temperatureUnit String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages ContainerModuleUsage[]

  @@index([containerVersionId])
  @@index([status])
  @@index([sortOrder])
}

model ContainerModuleUsage {
  id String @id @default(cuid())

  containerModuleId String
  usageId           String

  containerModule ContainerModule @relation(fields: [containerModuleId], references: [id], onDelete: Cascade)
  usage           ContainerUsage  @relation(fields: [usageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([containerModuleId, usageId])
  @@index([containerModuleId])
  @@index([usageId])
}

// -----------------------------------------------------
// Bestehende Container-Stammdaten
// -----------------------------------------------------

model Container {
  id String @id @default(cuid())

  status           ContainerStatus @default(ACTIVE)
  currentVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions       ContainerVersion[] @relation("ContainerVersions")
  currentVersion ContainerVersion?  @relation("ContainerCurrentVersion", fields: [currentVersionId], references: [id])

  contentsAsParent ContainerContent[] @relation("ContainerContentParent")
  contentsAsChild  ContainerContent[] @relation("ContainerContentChild")

  stocks ContainerStock[]

  @@index([status])
  @@index([currentVersionId])
}

model ContainerVersion {
  id String @id @default(cuid())

  // Bestehende technische Container-Relation bleibt erhalten.
  containerId String
  container   Container @relation("ContainerVersions", fields: [containerId], references: [id], onDelete: Cascade)

  // Neue fachliche Element-Relation. Optional, damit bestehende Daten und alte API-Pfade nicht brechen.
  containerElementId String?
  containerElement   ContainerElement? @relation(fields: [containerElementId], references: [id], onDelete: SetNull)

  versionNumber Int

  name      String
  shortName String?
  type      ContainerType

  sku     String?
  upc     String?
  ean     String?
  barcode String?

  imageMediaId String?
  imageUrl     String?

  emptyWeightInGrams  Int?
  heightInMillimeters Int?
  widthInMillimeters  Int?
  depthInMillimeters  Int?

  isReturnable Boolean @default(true)
  isReusable   Boolean @default(true)

  validFrom DateTime  @default(now())
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentForContainers Container[] @relation("ContainerCurrentVersion")

  contentsAsParentVersion ContainerContent[] @relation("ContainerContentParentVersion")
  contentsAsChildVersion  ContainerContent[] @relation("ContainerContentChildVersion")

  deposits ContainerDeposit[]
  stocks   ContainerStock[]
  modules  ContainerModule[]

  @@unique([containerId, versionNumber])
  @@index([containerId])
  @@index([containerElementId])
  @@index([type])
  @@index([sku])
  @@index([upc])
  @@index([ean])
  @@index([barcode])
}

model ContainerContent {
  id String @id @default(cuid())

  parentContainerId        String
  parentContainerVersionId String?

  contentType ContainerContentType

  productId        String?
  productVersionId String?

  childContainerId        String?
  childContainerVersionId String?

  // Neue Element-Relation für Fälle wie: 12 Flaschen pro Kiste.
  // Damit muss die enthaltene Einheit nicht zwingend ein konkreter Produkt- oder Container-Datensatz sein.
  contentContainerElementId String?

  quantity Int
  unit     ContainerContentUnit

  // Optionales Volumen, z. B. 40 l pro Box/Kiste.
  volume     Decimal?
  volumeUnit String?

  isDefault Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentContainer Container @relation("ContainerContentParent", fields: [parentContainerId], references: [id], onDelete: Cascade)
  parentContainerVersion ContainerVersion? @relation("ContainerContentParentVersion", fields: [parentContainerVersionId], references: [id], onDelete: SetNull)

  product Product? @relation("ContainerContentProduct", fields: [productId], references: [id])
  productVersion ProductVersion? @relation("ContainerContentProductVersion", fields: [productVersionId], references: [id])

  childContainer Container? @relation("ContainerContentChild", fields: [childContainerId], references: [id])
  childContainerVersion ContainerVersion? @relation("ContainerContentChildVersion", fields: [childContainerVersionId], references: [id])
  contentContainerElement ContainerElement? @relation("ContainerContentElement", fields: [contentContainerElementId], references: [id], onDelete: SetNull)

  prices ContainerContentPrice[]

  @@index([parentContainerId])
  @@index([parentContainerVersionId])
  @@index([contentType])
  @@index([productId])
  @@index([productVersionId])
  @@index([childContainerId])
  @@index([childContainerVersionId])
  @@index([contentContainerElementId])
  @@index([active])
}

model ContainerContentPrice {
  id String @id @default(cuid())

  containerContentId String
  containerContent   ContainerContent @relation(fields: [containerContentId], references: [id], onDelete: Cascade)

  mode ContainerContentPriceMode @default(PER_UNIT)

  unitSalePriceInCents  Int?
  totalSalePriceInCents Int?

  commissionInCents Int?
  commissionRateBps Int?

  currency String @default("EUR")

  validFrom DateTime  @default(now())
  validTo   DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([containerContentId])
  @@index([mode])
  @@index([active])
}

model ContainerDeposit {
  id String @id @default(cuid())

  containerVersionId String
  containerVersion   ContainerVersion @relation(fields: [containerVersionId], references: [id], onDelete: Cascade)

  type ContainerDepositType

  amountInCents Int
  currency      String @default("EUR")

  label String?
  note  String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([containerVersionId])
  @@index([type])
  @@index([active])
}

model ContainerStock {
  id String @id @default(cuid())

  containerId        String
  containerVersionId String?

  condition ContainerCondition @default(USED)
  fillState ContainerFillState @default(FULL)
  quantity  Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  container        Container         @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerVersion ContainerVersion? @relation(fields: [containerVersionId], references: [id], onDelete: SetNull)

  @@index([containerId])
  @@index([containerVersionId])
  @@index([condition])
  @@index([fillState])
}
