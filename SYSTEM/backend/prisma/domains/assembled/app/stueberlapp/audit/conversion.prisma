// =====================================================
// MODULE: STUEBERLAPP / AUDIT / CONVERSION
// =====================================================
// Conversion erklärt das Warum einer Übergabe / Umwandlung.
//
// Beispiele:
// - Würstchenpack öffnen: Product -> Article
// - Hotdog herstellen: Articles -> Product
// - Pfand zurückgeben: DepositProduct -> Finance
// - Wechselgeld vorbereiten: FinanceAccount -> FinanceAccount
//
// Conversion verändert keinen Bestand direkt.
// Die tatsächlichen Bestands-/Wertänderungen bleiben in
// ProductTransaction, ArticleTransaction, DepositTransaction und FinanceTransaction.
// =====================================================

enum ConversionType {
  PRODUCT_TO_ARTICLE
  ARTICLE_TO_PRODUCT
  ARTICLE_TO_ARTICLE
  PRODUCT_TO_PRODUCT
  DEPOSIT_TO_FINANCE
  FINANCE_TO_FINANCE
  MIXED
  OTHER
}

enum ConversionTransactionStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum ConversionDirection {
  INPUT
  OUTPUT
}

enum ConversionTargetType {
  PRODUCT
  ARTICLE
  DEPOSIT_PRODUCT
  FINANCE_ACCOUNT
  FINANCE_RESERVE
}

model Conversion {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  description String?
  type        ConversionType @default(OTHER)

  active      Boolean @default(true)
  sortOrder   Int     @default(100)

  // Optional: Vorlage/Regel/Standardrezept dieser Umwandlung.
  templateJson Json?
  ruleJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ConversionTransaction[]
  inputs       ConversionInput[]
  outputs      ConversionOutput[]

  @@index([type])
  @@index([active])
}

model ConversionTransaction {
  id           String                      @id @default(cuid())
  conversionId String?
  conversion   Conversion?                 @relation(fields: [conversionId], references: [id])

  type         ConversionType
  status       ConversionTransactionStatus @default(POSTED)

  title        String?
  reason       String?
  note         String?

  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  createdByAccountId String?

  // Externe Quelle, z. B. POS, Küche, manuelle Aktion, Abschluss.
  sourceModule String?
  sourceType   String?
  sourceId     String?

  inputs  ConversionInput[]
  outputs ConversionOutput[]

  productTransactions ProductTransaction[] @relation("ConversionProductTransactions")
  articleTransactions ArticleTransaction[] @relation("ConversionArticleTransactions")
  depositTransactions DepositTransaction[] @relation("ConversionDepositTransactions")
  financeTransactions FinanceTransaction[] @relation("ConversionFinanceTransactions")

  stockReasonEntries StockReasonEntry[]

  @@index([conversionId])
  @@index([type])
  @@index([status])
  @@index([occurredAt])
  @@index([sourceModule, sourceType, sourceId])
}

model ConversionInput {
  id String @id @default(cuid())

  conversionId String?
  conversion   Conversion? @relation(fields: [conversionId], references: [id])

  transactionId String
  transaction   ConversionTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  targetType ConversionTargetType

  productId String?
  product   Product? @relation("ConversionInputProduct", fields: [productId], references: [id])

  articleId String?
  article   Article? @relation("ConversionInputArticle", fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation("ConversionInputDepositProduct", fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation("ConversionInputFinanceAccount", fields: [financeAccountId], references: [id])

  financeReserveId String?
  financeReserve   FinanceReserve? @relation("ConversionInputFinanceReserve", fields: [financeReserveId], references: [id])

  quantity Decimal? @db.Decimal(14, 4)
  amountCents Int?
  currency String @default("EUR")
  unitId String?

  productTransactionId String?
  articleTransactionId String?
  depositTransactionId String?
  financeTransactionId String?

  note String?
  createdAt DateTime @default(now())

  @@index([conversionId])
  @@index([transactionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([financeReserveId])
}

model ConversionOutput {
  id String @id @default(cuid())

  conversionId String?
  conversion   Conversion? @relation(fields: [conversionId], references: [id])

  transactionId String
  transaction   ConversionTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  targetType ConversionTargetType

  productId String?
  product   Product? @relation("ConversionOutputProduct", fields: [productId], references: [id])

  articleId String?
  article   Article? @relation("ConversionOutputArticle", fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation("ConversionOutputDepositProduct", fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation("ConversionOutputFinanceAccount", fields: [financeAccountId], references: [id])

  financeReserveId String?
  financeReserve   FinanceReserve? @relation("ConversionOutputFinanceReserve", fields: [financeReserveId], references: [id])

  quantity Decimal? @db.Decimal(14, 4)
  amountCents Int?
  currency String @default("EUR")
  unitId String?

  productTransactionId String?
  articleTransactionId String?
  depositTransactionId String?
  financeTransactionId String?

  note String?
  createdAt DateTime @default(now())

  @@index([conversionId])
  @@index([transactionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([financeReserveId])
}
