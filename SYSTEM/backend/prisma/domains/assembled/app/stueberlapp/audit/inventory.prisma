// =====================================================
// MODULE: STUEBERLAPP / AUDIT / INVENTORY
// =====================================================
// Inventory = Inventur / Bestandsprüfung.
//
// Inventory ist ein Audit-Modul, weil es prüft, zählt, vergleicht
// und Korrekturvorschläge protokolliert.
//
// Inventory verändert keinen Bestand direkt.
// Korrekturen werden als ProductTransaction, ArticleTransaction,
// DepositTransaction oder FinanceTransaction gebucht.
// =====================================================

enum InventorySessionStatus {
  DRAFT
  OPEN
  COUNTING
  REVIEW
  APPROVED
  CLOSED
  REVERTED
  CANCELLED
}

enum InventoryTargetType {
  PRODUCT
  ARTICLE
  DEPOSIT_PRODUCT
  FINANCE_ACCOUNT
}

enum InventoryCorrectionStatus {
  PROPOSED
  APPLIED
  REJECTED
}

model InventorySession {
  id          String                 @id @default(cuid())
  title       String
  description String?
  status      InventorySessionStatus @default(DRAFT)

  startedAt   DateTime?
  closedAt    DateTime?
  revertedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  createdByAccountId  String?
  approvedByAccountId String?
  revertedByAccountId String?

  scopes      InventoryScope[]
  snapshots   InventorySnapshot[]
  stocks      InventoryStock[]
  differences InventoryDifference[]
  corrections InventoryCorrection[]
  approvals   InventoryApproval[]
  reports     InventoryReport[]

  @@index([status])
  @@index([createdAt])
}

model InventoryScope {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  targetType InventoryTargetType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation(fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])

  locationId String?
  note       String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([locationId])
}

model InventorySnapshot {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  targetType InventoryTargetType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation(fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])

  locationId String?

  // Eingefrorener berechneter Systembestand / Finanzstand zum Inventurstart.
  calculatedQuantity Decimal? @db.Decimal(14, 4)
  calculatedValueCents Int?
  currency String @default("EUR")
  unitId String?

  sourceCalculationId String?

  capturedAt DateTime @default(now())
  capturedByAccountId String?
  note String?

  stocks InventoryStock[]

  @@index([sessionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([locationId])
}

model InventoryStock {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  snapshotId String?
  snapshot   InventorySnapshot? @relation(fields: [snapshotId], references: [id])

  targetType InventoryTargetType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation(fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])

  locationId String?

  expectedQuantity Decimal? @db.Decimal(14, 4)
  expectedValueCents Int?

  countedQuantity Decimal? @db.Decimal(14, 4)
  countedValueCents Int?
  currency String @default("EUR")

  unitId String?
  note   String?

  countedByAccountId String?
  countedAt DateTime @default(now())

  differences InventoryDifference[]

  @@index([sessionId])
  @@index([snapshotId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([locationId])
}

model InventoryDifference {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inventoryStockId String?
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])

  targetType InventoryTargetType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation(fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])

  locationId String?

  expectedQuantity Decimal? @db.Decimal(14, 4)
  countedQuantity  Decimal? @db.Decimal(14, 4)
  differenceQuantity Decimal? @db.Decimal(14, 4)

  expectedValueCents Int?
  countedValueCents  Int?
  differenceValueCents Int?
  currency String @default("EUR")

  reason String?
  note   String?
  createdAt DateTime @default(now())

  corrections InventoryCorrection[]

  @@index([sessionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
}

model InventoryCorrection {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  differenceId String?
  difference   InventoryDifference? @relation(fields: [differenceId], references: [id])

  targetType InventoryTargetType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])

  depositProductId String?
  depositProduct   DepositProduct? @relation(fields: [depositProductId], references: [id])

  financeAccountId String?
  financeAccount   FinanceAccount? @relation(fields: [financeAccountId], references: [id])

  status InventoryCorrectionStatus @default(PROPOSED)
  correctionQuantity Decimal? @db.Decimal(14, 4)
  correctionValueCents Int?
  currency String @default("EUR")

  productTransactionId String?
  articleTransactionId String?
  depositTransactionId String?
  financeTransactionId String?

  proposedByAccountId String?
  appliedByAccountId  String?
  proposedAt DateTime @default(now())
  appliedAt  DateTime?

  stockReasonEntries StockReasonEntry[]

  @@index([sessionId])
  @@index([targetType])
  @@index([productId])
  @@index([articleId])
  @@index([depositProductId])
  @@index([financeAccountId])
  @@index([status])
}

model InventoryApproval {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  approvedByAccountId String?
  note String?
  approvedAt DateTime @default(now())

  @@index([sessionId])
}

model InventoryReport {
  id        String           @id @default(cuid())
  sessionId String
  session   InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type      String
  fileId    String?
  fileName  String?
  summaryJson Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
}
