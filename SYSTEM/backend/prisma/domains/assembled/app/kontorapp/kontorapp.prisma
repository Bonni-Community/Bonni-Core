// Durable append-only replay ledger for legacy APIs that call the protected
// organization provider outside the database transaction. A single mutable
// projection payload cannot safely retain response identity across A -> B ->
// retry-A sequences, so every actor/route/resource/key claim is independent.
// Only hashes and public projection revision are persisted; protected fields,
// documents and access grants are never copied into this ledger.
model KontorContractLegacyOperation {
  scopeKey          String   @id
  contractId        String
  contract          KontorContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  accountId         String
  operation         String
  idempotencyKeyHash String
  requestHash       String
  state             String   @default("PROCESSING")
  leaseId           String?  @unique
  responseHash      String?
  responseRevision  Int?
  encryptedResponse String?
  completedAt       DateTime?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([contractId, operation, createdAt])
  @@index([state, expiresAt])
}

// Phase 7 – Dokumente und digitale Ablage.  The new document store is
// deliberately additive: existing Core archive entries, protected documents
// and specialist originals remain canonical at their current owners and are
// exposed as projections by the module.  Only newly uploaded originals live in
// these tables.
model KontorDocumentFolder {
  id                       String                 @id @default(cuid())
  parentId                 String?
  parent                   KontorDocumentFolder?  @relation("KontorDocumentFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 KontorDocumentFolder[] @relation("KontorDocumentFolderTree")
  scopeType                String
  scopeId                  String?
  name                     String
  normalizedName           String
  uniquePathKey            String                 @unique
  revision                 Int                    @default(1)
  archivedAt               DateTime?
  createdByAccountId       String?
  createdByLabelSnapshot   String?
  createdByRolesSnapshot   Json                   @default("[]")
  documents                KontorStoredDocument[]
  grants                   KontorDocumentGrant[]  @relation("KontorDocumentFolderGrants")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([scopeType, scopeId, archivedAt, name])
  @@index([parentId, archivedAt, name])
}

// Original bytes and identity are immutable.  Metadata, security, retention
// and lifecycle fields form a CAS protected projection via recordRevision.
// A replacement file always creates a new row linked through previousVersionId.
model KontorStoredDocument {
  id                       String                                  @id @default(cuid())
  folderId                 String
  folder                   KontorDocumentFolder                    @relation(fields: [folderId], references: [id], onDelete: Restrict)
  scopeType                String
  scopeId                  String?
  rootDocumentId           String?
  rootDocument             KontorStoredDocument?                   @relation("KontorStoredDocumentRoot", fields: [rootDocumentId], references: [id], onDelete: Restrict)
  rootVersions             KontorStoredDocument[]                  @relation("KontorStoredDocumentRoot")
  previousVersionId        String?                                 @unique
  previousVersion          KontorStoredDocument?                   @relation("KontorStoredDocumentPrevious", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion              KontorStoredDocument?                   @relation("KontorStoredDocumentPrevious")
  version                  Int                                     @default(1)
  recordRevision           Int                                     @default(1)
  title                    String
  description              String?
  category                 String                                  @default("OTHER")
  tags                     Json                                    @default("[]")
  validFrom                DateTime?
  validUntil               DateTime?
  fileName                 String
  claimedMimeType          String
  detectedMimeType         String
  sizeInBytes              Int
  checksum                 String
  encryptedData            String?
  encryptionKeyId          String?
  securityStatus           String                                  @default("QUARANTINED")
  securityRevision         Int                                     @default(1)
  scannerLeaseId           String?
  scannerLeaseRequestId    String?                                 @unique
  scannerLeaseUntil        DateTime?
  scannerDeliveryAttempts  Int                                     @default(0)
  archivedAt               DateTime?
  retentionUntil           DateTime?
  legalHold                Boolean                                 @default(false)
  legalHoldReason          String?
  deletionRequestedAt      DateTime?
  deletionEligibleAt       DateTime?
  erasedAt                 DateTime?
  createdByAccountId       String?
  createdByLabelSnapshot   String?
  createdByRolesSnapshot   Json                                    @default("[]")
  links                    KontorStoredDocumentLink[]
  grants                   KontorDocumentGrant[]                   @relation("KontorStoredDocumentGrants")
  deletionRequests         KontorDocumentDeletionRequest[]
  securityScans            KontorStoredDocumentScan[]
  securityDecisions        KontorStoredDocumentSecurityDecision[]
  tombstone                KontorDocumentTombstone?
  exportDependencies       KontorDocumentExportDependency[]
  contributionArtifacts    KontorContributionArtifact[]
  contributionLinks        KontorContributionDocumentLink[]
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt

  @@unique([rootDocumentId, version])
  @@index([folderId, archivedAt, createdAt])
  @@index([scopeType, scopeId, archivedAt, createdAt])
  @@index([checksum])
  @@index([securityStatus, scannerLeaseUntil, createdAt])
  @@index([retentionUntil, legalHold, deletionEligibleAt])
}

// Link changes are append-only.  Removing a link appends a REMOVED leaf that
// supersedes the previous ACTIVE row; specialist source records are never
// mutated or deleted by this store.
model KontorStoredDocumentLink {
  id                       String               @id @default(cuid())
  documentId               String
  document                 KontorStoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision                 Int
  state                    String               @default("ACTIVE")
  targetType               String
  targetId                 String
  targetRevisionSnapshot   Int?
  targetLabelSnapshot      String
  supersedesLinkId         String?              @unique
  supersedesLink           KontorStoredDocumentLink? @relation("KontorStoredDocumentLinkChain", fields: [supersedesLinkId], references: [id], onDelete: Restrict)
  supersededBy             KontorStoredDocumentLink? @relation("KontorStoredDocumentLinkChain")
  reason                   String?
  createdByAccountId       String?
  createdByLabelSnapshot   String?
  createdByRolesSnapshot   Json                 @default("[]")
  createdAt                DateTime             @default(now())

  @@unique([documentId, revision])
  @@index([targetType, targetId, state])
  @@index([documentId, state, createdAt])
}

// Folder- and document-level ACL facts are append-only.  ALLOW and DENY are
// both explicit so a child can immediately revoke inherited access.
model KontorDocumentGrant {
  id                       String                @id @default(cuid())
  resourceKey              String
  folderId                 String?
  folder                   KontorDocumentFolder? @relation("KontorDocumentFolderGrants", fields: [folderId], references: [id], onDelete: Restrict)
  documentId               String?
  document                 KontorStoredDocument? @relation("KontorStoredDocumentGrants", fields: [documentId], references: [id], onDelete: Restrict)
  revision                 Int
  subjectType              String
  subjectId                String
  effect                   String                @default("ALLOW")
  capabilities             Json                  @default("[]")
  inherited                Boolean               @default(true)
  supersedesGrantId        String?               @unique
  supersedesGrant          KontorDocumentGrant?  @relation("KontorDocumentGrantChain", fields: [supersedesGrantId], references: [id], onDelete: Restrict)
  supersededBy             KontorDocumentGrant?  @relation("KontorDocumentGrantChain")
  reason                   String?
  expiresAt                DateTime?
  createdByAccountId       String?
  createdByLabelSnapshot   String?
  createdByRolesSnapshot   Json                  @default("[]")
  createdAt                DateTime              @default(now())

  @@index([folderId, subjectType, subjectId, createdAt])
  @@index([documentId, subjectType, subjectId, createdAt])
  @@index([expiresAt])
  @@unique([resourceKey, revision])
}

model KontorDocumentDeletionRequest {
  id                       String               @id @default(cuid())
  documentId               String
  document                 KontorStoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  expectedRevision         Int
  state                    String               @default("REQUESTED")
  reason                   String
  requestedByAccountId     String
  requestedByLabelSnapshot String?
  requestedByRolesSnapshot Json                 @default("[]")
  approvedByAccountId      String?
  approvedByLabelSnapshot  String?
  approvedByRolesSnapshot  Json                 @default("[]")
  approvedAt               DateTime?
  rejectedAt               DateTime?
  erasedAt                 DateTime?
  createdAt                DateTime             @default(now())
  activeKey                String?              @unique

  @@index([documentId, state, createdAt])
  @@index([state, createdAt])
}

model KontorStoredDocumentScan {
  id                       String               @id @default(cuid())
  documentId               String
  document                 KontorStoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  attempt                  Int
  providerKey              String
  engineVersion            String?
  trustedAdapterDomain     String
  payloadHash              String
  contentChecksum          String
  verdict                  String
  signatureSet             String?
  resultHash               String
  details                  Json                 @default("{}")
  scannedAt                DateTime             @default(now())

  @@unique([documentId, attempt])
  @@index([contentChecksum])
}

model KontorStoredDocumentSecurityDecision {
  id                       String               @id @default(cuid())
  documentId               String
  document                 KontorStoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision                 Int
  decision                 String
  previousStatus           String
  newStatus                String
  scanId                   String?
  actorAccountId           String?
  actorLabelSnapshot       String?
  actorRolesSnapshot       Json                 @default("[]")
  reason                   String?
  metadata                 Json?
  createdAt                DateTime             @default(now())

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

// Every read and mutation produces an immutable history fact.  sequence is
// scoped to a target and allocated transactionally; targetRevision records the
// resource snapshot observed by the operation without changing it for reads.
model KontorStoredDocumentHistory {
  id                       String   @id @default(cuid())
  targetType               String
  targetId                 String
  sequence                 Int
  targetRevision           Int
  event                    String
  actorAccountId           String?
  actorLabelSnapshot       String?
  actorRolesSnapshot       Json     @default("[]")
  note                     String?
  beforeState              Json?
  afterState               Json?
  createdAt                DateTime @default(now())

  @@unique([targetType, targetId, sequence])
  @@index([targetType, targetId, createdAt])
  @@index([event, createdAt])
}

model KontorDocumentActionChallenge {
  challengeId              String   @id
  resourceType             String
  resourceId               String
  action                   String
  expectedRevision         Int
  dependencyHash           String
  actorAccountId           String
  actorLabelSnapshot       String?
  verifiedAt               DateTime?
  consumedAt               DateTime?
  createdAt                DateTime @default(now())

  @@index([resourceType, resourceId, action, createdAt])
  @@index([actorAccountId, consumedAt])
}

model KontorDocumentIdempotency {
  scopeKey                 String   @id
  accountId                String
  operation                String
  resourceKey              String
  idempotencyKey           String
  requestHash              String
  status                   String   @default("PROCESSING")
  responseStatus           Int?
  responseBody             Json?
  encryptedResponse        String?
  sensitiveResponseExpiresAt DateTime?
  artifactData             Bytes?
  artifactHash             String?
  artifactMimeType         String?
  artifactFileName         String?
  artifactRetainUntil      DateTime?
  targetId                 String?
  targetRevision           Int?
  createdAt                DateTime @default(now())
  completedAt              DateTime?
  expiresAt                DateTime
  exportDependencies       KontorDocumentExportDependency[]

  @@index([accountId, operation, resourceKey, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([artifactRetainUntil])
}

// An encrypted ZIP must be crypto-shredded together with every original it
// contains. JSON payloads are intentionally not used as a reverse index:
// erasure needs one bounded, transactional lookup that survives restarts.
model KontorDocumentExportDependency {
  id                       String                    @id @default(cuid())
  idempotencyScopeKey      String
  idempotency              KontorDocumentIdempotency @relation(fields: [idempotencyScopeKey], references: [scopeKey], onDelete: Restrict)
  documentId               String
  document                 KontorStoredDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdAt                DateTime                  @default(now())

  @@unique([idempotencyScopeKey, documentId])
  @@index([documentId, createdAt])
  @@index([idempotencyScopeKey])
}

// The document row retains public provenance after ciphertext erasure.  This
// separate one-to-one fact makes it impossible to mistake a missing blob for a
// storage defect or to silently recreate a deleted original.
model KontorDocumentTombstone {
  id                       String               @id @default(cuid())
  documentId               String               @unique
  document                 KontorStoredDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  checksum                 String
  sizeInBytes              Int
  reason                   String
  erasedByAccountId        String?
  erasedByLabelSnapshot    String?
  erasedByRolesSnapshot    Json                 @default("[]")
  metadataHash             String
  erasedAt                 DateTime             @default(now())

  @@index([erasedAt])
}


model KontorStueberlHistoryRun {
  id String @id @default(cuid())
  requestKey String @unique
  requestHash String
  fromDate String
  toDate String
  cutoffAt DateTime
  cursor String @default("")
  status String @default("COLLECTING")
  revision Int @default(1)
  createdByAccountId String
  confirmedByAccountId String?
  confirmKey String? @unique
  confirmHash String?
  confirmedAt DateTime?
  requestMessageId String?
  lastError String?
  leaseUntil DateTime?
  rows KontorStueberlHistoryRow[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model KontorStueberlHistoryRow {
  id String @id @default(cuid())
  runId String
  run KontorStueberlHistoryRun @relation(fields:[runId], references:[id], onDelete:Restrict)
  sourceId String
  receivableExternalId String
  description String
  paidAt DateTime
  amountCents Int
  status String
  reason String?
  sourceHash String?
  planHash String?
  payload Json
  importedReceivableId String?
  importedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([runId, receivableExternalId])
  @@index([runId, status])
}

model KontorStueberlAccountOperation {
  operationId String @id
  requestHash String
  memberId String
  receivableExternalId String
  owner String
  kind String
  amountCents Int
  creditDeltaCents Int
  occurredAt DateTime
  reason String
  actorAccountId String
  command Json
  result Json
  responseMessageId String?
  createdAt DateTime @default(now())
  @@index([memberId, owner, createdAt])
  @@index([receivableExternalId])
}

// Imported local balances remain separate from Kontor-led live balances.
model KontorStueberlImportedCredit {
  memberId String @id
  balanceCents Int @default(0)
  revision Int @default(0)
  lastOperationId String?
  updatedAt DateTime @updatedAt
}
