model KontorPaymentClaimAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   KontorPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  claimId   String
  claim     KontorClaim   @relation(fields: [claimId], references: [id], onDelete: Restrict)
  invoiceId String?
  invoice   KontorInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  postingProfileRevisionId String?
  postingProfileHash String?
  accountingMethodSnapshot String?
  amount    Decimal       @db.Decimal(14, 2)
  createdAt DateTime      @default(now())

  @@unique([paymentId, claimId])
  @@index([claimId, createdAt])
  @@index([invoiceId])
  @@index([postingProfileRevisionId])
}

model KontorReturnDebit {
  id                 String   @id @default(cuid())
  paymentId          String?  @unique
  payment            KontorPayment? @relation("ContributionPaymentReturnDebit", fields: [paymentId], references: [id], onDelete: Restrict)
  financeEntryId     String?
  bankTransactionId  String?
  directDebitItemId  String?
  directDebitItem    KontorDirectDebitItem? @relation("ContributionDirectDebitItemReturns", fields: [directDebitItemId], references: [id], onDelete: Restrict)
  claimId            String
  claim              KontorClaim @relation("ContributionClaimReturnDebits", fields: [claimId], references: [id], onDelete: Restrict)
  memberId           String
  amount             Decimal  @db.Decimal(14, 2)
  feeAmount          Decimal  @db.Decimal(14, 2)
  feeTreatment       String?
  feeClaimId         String?  @unique
  feeClaim           KontorClaim? @relation("ReturnDebitFeeClaim", fields: [feeClaimId], references: [id], onDelete: Restrict)
  reason             String?
  status             String   @default("OPEN")
  occurredAt         DateTime @default(now())
  createdByAccountId String?
  idempotencyKey     String?  @unique
  postingProfileRevisionId String?
  postingProfileHash String?
  accountingMethodSnapshot String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([claimId, status])
  @@index([financeEntryId])
  @@index([bankTransactionId])
  @@index([directDebitItemId])
}

model KontorDunning {
  id                 String   @id @default(cuid())
  claimId            String
  claim              KontorClaim @relation("ContributionClaimDunnings", fields: [claimId], references: [id], onDelete: Restrict)
  invoiceId          String?
  invoice            KontorInvoice? @relation("ContributionInvoiceDunnings", fields: [invoiceId], references: [id], onDelete: Restrict)
  memberId           String
  level              Int      @default(1)
  reason             String?
  feeAmount          Decimal  @db.Decimal(14, 2)
  feeClaimId         String?  @unique
  feeClaim           KontorClaim? @relation("DunningFeeClaim", fields: [feeClaimId], references: [id], onDelete: Restrict)
  issuedAt           DateTime @default(now())
  dueDate             DateTime
  status              String   @default("OPEN")
  contentRevision     Int      @default(1)
  snapshotHash        String?
  claimOpenAmountSnapshot Decimal? @db.Decimal(14, 2)
  totalDueSnapshot    Decimal? @db.Decimal(14, 2)
  artifactId          String?  @unique
  artifact            KontorContributionArtifact? @relation("KontorDunningArtifact", fields: [artifactId], references: [id], onDelete: Restrict)
  createdByAccountId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([claimId, level])
  @@index([memberId, status])
}

// Generated invoices and dunnings keep immutable metadata here while their
// only original bytes live encrypted in the canonical Phase-7 document store.
// Both hashes must match before a replay may return the result.
model KontorContributionArtifact {
  id                 String                @id @default(cuid())
  targetType         String
  targetId           String
  revision           Int                   @default(1)
  fileName           String
  mimeType           String                @default("application/pdf")
  checksum           String
  sizeInBytes        Int
  snapshotHash       String
  storedDocumentId   String                @unique
  storedDocument     KontorStoredDocument  @relation(fields: [storedDocumentId], references: [id], onDelete: Restrict)
  invoice            KontorInvoice?        @relation("KontorInvoiceArtifact")
  dunning            KontorDunning?        @relation("KontorDunningArtifact")
  documentLinks      KontorContributionDocumentLink[]
  createdByAccountId String?
  createdAt          DateTime              @default(now())

  @@unique([targetType, targetId, revision])
  @@index([checksum])
}

model KontorContributionDocumentLink {
  id                       String                           @id @default(cuid())
  targetType               String
  targetId                 String
  revision                 Int
  state                    String                           @default("ACTIVE")
  artifactId               String
  artifact                 KontorContributionArtifact       @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  storedDocumentId         String
  storedDocument           KontorStoredDocument             @relation(fields: [storedDocumentId], references: [id], onDelete: Restrict)
  documentRevisionSnapshot Int
  checksumSnapshot         String
  sizeInBytesSnapshot      Int
  fileNameSnapshot         String
  mimeTypeSnapshot         String
  supersedesLinkId         String?                          @unique
  supersedesLink           KontorContributionDocumentLink?  @relation("ContributionDocumentLinkChain", fields: [supersedesLinkId], references: [id], onDelete: Restrict)
  supersededBy             KontorContributionDocumentLink?  @relation("ContributionDocumentLinkChain")
  createdByAccountId       String?
  createdAt                DateTime                         @default(now())

  @@unique([targetType, targetId, revision])
  @@index([storedDocumentId, createdAt])
}

model KontorContributionDispatchLink {
  id                       String                           @id @default(cuid())
  targetType               String
  targetId                 String
  revision                 Int
  state                    String                           @default("ACTIVE")
  dispatchId               String
  dispatch                 KontorDispatch                   @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  channelSnapshot          String
  subjectSnapshot          String?
  bodyHashSnapshot         String
  recipientCountSnapshot   Int
  recipientSnapshotHash    String?
  supersedesLinkId         String?                          @unique
  supersedesLink           KontorContributionDispatchLink?  @relation("ContributionDispatchLinkChain", fields: [supersedesLinkId], references: [id], onDelete: Restrict)
  supersededBy             KontorContributionDispatchLink?  @relation("ContributionDispatchLinkChain")
  createdByAccountId       String?
  createdAt                DateTime                         @default(now())

  @@unique([targetType, targetId, revision])
  @@index([dispatchId, createdAt])
}

model KontorContributionHistory {
  id                 String   @id @default(cuid())
  targetType         String
  targetId           String
  sequence           Int
  targetRevision     Int
  event              String
  actorAccountId     String?
  actorLabelSnapshot String?
  actorRolesSnapshot Json     @default("[]")
  note               String?
  beforeState        Json?
  afterState         Json?
  createdAt          DateTime @default(now())

  @@unique([targetType, targetId, sequence])
  @@index([targetType, targetId, createdAt])
  @@index([event, createdAt])
}

model KontorContributionActionChallenge {
  challengeId      String   @id
  targetType       String
  targetId         String
  action           String
  expectedRevision Int
  dependencyHash   String
  actorAccountId   String
  verifiedAt       DateTime?
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([targetType, targetId, action, createdAt])
  @@index([actorAccountId, consumedAt, expiresAt])
}

model KontorContributionIdempotency {
  scopeKey       String   @id
  operation      String
  actorAccountId String
  resourceKey    String
  idempotencyKey String
  requestHash    String
  status         String   @default("PROCESSING")
  responseStatus Int?
  responseBody   Json?
  encryptedResponse String?
  sensitiveResponseExpiresAt DateTime?
  resultType     String?
  resultId       String?
  resultRevision Int?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([actorAccountId, operation, resourceKey, createdAt])
  @@index([status, expiresAt])
}

model KontorAuditReview {
  id                String   @id @default(cuid())
  targetType        String
  targetId          String
  reviewerAccountId String
  status            String
  note              String?
  targetUpdatedAt   DateTime?
  targetRevision    Int?
  reviewedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([targetType, targetId, reviewerAccountId, reviewedAt])
  @@index([targetType, targetId])
}

model KontorAuditEntry {
  id        String   @id @default(cuid())
  event     String
  targetType String
  targetId  String?
  accountId String?
  metadata  Json?
  actorLabel String?
  targetRevision Int?
  beforeState Json?
  afterState Json?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KontorMessageTemplate {
  id                 String           @id @default(cuid())
  name               String
  templateType       String
  subject            String?
  body               String
  description        String?
  outputFormat       String
  placeholders       Json             @default("[]")
  active             Boolean          @default(true)
  createdByAccountId String?
  dispatches         KontorDispatch[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([active, name])
}

model KontorDispatch {
  id                 String                    @id @default(cuid())
  templateId         String?
  template           KontorMessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel            String
  purpose            String?
  subjectSnapshot    String?
  bodySnapshot       String
  status             String                    @default("DRAFT")
  meetingId          String?
  calendarEventId    String?
  calendarEvent      KontorCalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdByAccountId String?
  recipients         KontorDispatchRecipient[]
  contributionLinks  KontorContributionDispatchLink[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([createdAt])
  @@index([meetingId])
  @@index([calendarEventId])
}

model KontorDispatchRecipient {
  id                  String         @id @default(cuid())
  dispatchId          String
  dispatch            KontorDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  memberId            String
  addressSnapshot     String?
  displayNameSnapshot String?
  status              String         @default("PENDING")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([dispatchId])
  @@index([memberId])
}

// Phase 5 – das wirksame Beschaffungsregelwerk wird niemals in-place
// umgedeutet. Jede Änderung erzeugt eine neue, datierte Revision; bestehende
// Anschaffungsakten halten die bei Anlage wirksame Revision fest.
model KontorProcurementRuleSet {
  id                 String                         @id @default("default")
  revision           Int                            @default(0)
  activeRevisionId   String?                        @unique
  activeRevision     KontorProcurementRuleRevision? @relation("ActiveProcurementRule", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions          KontorProcurementRuleRevision[] @relation("ProcurementRuleSetRevisions")
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
}

model KontorProcurementRuleRevision {
  id                       String                   @id @default(cuid())
  ruleSetId                String
  ruleSet                  KontorProcurementRuleSet @relation("ProcurementRuleSetRevisions", fields: [ruleSetId], references: [id], onDelete: Restrict)
  activeFor                KontorProcurementRuleSet? @relation("ActiveProcurementRule")
  revision                 Int
  effectiveFrom            DateTime
  effectiveUntil           DateTime?
  conditions               Json                     @default("[]")
  requiredRoles            Json                     @default("[]")
  requiredResolutionTypes  Json                     @default("[]")
  allowOverride            Boolean                  @default(false)
  overrideRoles            Json                     @default("[]")
  note                     String?
  createdByAccountId       String?
  createdAt                DateTime                  @default(now())
  cases                    KontorProcurementCase[]

  @@unique([ruleSetId, revision])
  @@index([ruleSetId, effectiveFrom, effectiveUntil])
}

model KontorProcurementCase {
  id                       String                            @id @default(cuid())
  caseNumber               String                            @unique
  title                    String
  description              String?
  status                   String                            @default("DRAFT")
  revision                 Int                               @default(1)
  ownerAccountId           String?
  ownerLabel               String?
  ownerRole                String?
  estimatedAmount          Decimal                           @db.Decimal(14, 2)
  approvedCeiling          Decimal?                          @db.Decimal(14, 2)
  targetDate               DateTime?
  currency                 String                            @default("EUR")
  savingsGoalId            String?                           @unique
  savingsGoal              KontorSavingsGoal?                @relation(fields: [savingsGoalId], references: [id], onDelete: Restrict)
  approvalScope            String                            @default("FUNCTIONAL")
  approvalScopeText        String?
  ruleRevisionId           String?
  ruleRevision             KontorProcurementRuleRevision?    @relation(fields: [ruleRevisionId], references: [id], onDelete: Restrict)
  workflowProgress         Int                               @default(0)
  completionOverrideReason String?
  completionOverrideBy     String?
  completedAt              DateTime?
  completedByAccountId     String?
  completionSnapshot       Json?
  completionSnapshotHash   String?
  fundDisposition          String?
  settlementState          String                            @default("OPEN_PROTECTED")
  cancellationReason       String?
  cancelledAt              DateTime?
  cancelledByAccountId     String?
  parts                    KontorProcurementPart[]
  offers                   KontorProcurementOffer[]
  offerDecisions           KontorProcurementOfferDecision[]
  profileRevisions         KontorProcurementCaseProfileRevision[]
  documents                KontorProcurementDocument[]
  approvals                KontorProcurementApproval[]
  agendaItems              KontorProcurementAgendaItem[]
  savingsMovements         KontorProcurementSavingsMovement[]
  savingsReservations      KontorProcurementSavingsReservation[]
  orders                   KontorProcurementOrder[]
  deliveries               KontorProcurementDelivery[]
  invoices                 KontorProcurementInvoiceLink[]
  followUps                KontorProcurementFollowUp[]
  recurringCosts           KontorProcurementRecurringCost[]
  assets                   KontorProcurementAsset[]
  assetEvents              KontorProcurementAssetEvent[]
  history                  KontorProcurementHistory[]
  actionChallenges         KontorProcurementActionChallenge[]
  createdByAccountId       String?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  @@index([status, targetDate])
  @@index([ownerAccountId, status])
  @@index([ruleRevisionId])
  @@index([savingsGoalId])
}

// Phase 8 – fachliche Stammdaten werden nicht mehr in-place historisiert.
// Jede relevante Plan-/Sparzielaenderung erzeugt zusaetzlich einen
// unveraenderlichen Snapshot. Bestehende Phase-7-Akten ohne Snapshot werden
// im Service ausdruecklich als Legacy-Prueffall behandelt.
model KontorProcurementCaseProfileRevision {
  id                       String                 @id @default(cuid())
  caseId                   String
  case                     KontorProcurementCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  revision                 Int
  title                    String
  description              String?
  estimatedAmount          Decimal                @db.Decimal(14, 2)
  approvedCeiling          Decimal?               @db.Decimal(14, 2)
  targetDate               DateTime?
  ownerAccountId           String?
  ownerLabel               String?
  ownerRole                String?
  approvalScope            String
  approvalScopeText        String?
  savingsStartsAt          DateTime?
  savingsEndsAt            DateTime?
  savingsTargetAmount      Decimal?               @db.Decimal(14, 2)
  legacyBaseline           Boolean                @default(false)
  changeReason             String?
  supersedesProfileRevisionId String?                         @unique
  supersedesProfileRevision   KontorProcurementCaseProfileRevision? @relation("ProcurementProfileRevisionChain", fields: [supersedesProfileRevisionId], references: [id], onDelete: Restrict)
  supersededBy                KontorProcurementCaseProfileRevision? @relation("ProcurementProfileRevisionChain")
  actorAccountId           String?
  actorLabel               String?
  createdAt                DateTime               @default(now())

  @@unique([caseId, revision])
  @@index([caseId, createdAt])
  @@index([supersedesProfileRevisionId])
}

model KontorProcurementPart {
  id                 String                 @id @default(cuid())
  caseId             String
  case               KontorProcurementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  targetAmount       Decimal                @db.Decimal(14, 2)
  allocatedBudget    Decimal                @default(0) @db.Decimal(14, 2)
  status             String                 @default("PLANNED")
  sortOrder          Int                    @default(0)
  supersedesPartId   String?                @unique
  correctionReason   String?
  createdByAccountId String?
  createdAt          DateTime               @default(now())

  @@index([caseId, sortOrder])
  @@index([supersedesPartId])
}

model KontorProcurementOffer {
  id                 String                 @id @default(cuid())
  caseId             String
  case               KontorProcurementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  partId             String?
  supplierName       String
  model              String?
  status             String                 @default("RECEIVED")
  netAmount          Decimal                @db.Decimal(14, 2)
  taxAmount          Decimal                @db.Decimal(14, 2)
  grossAmount        Decimal                @db.Decimal(14, 2)
  ancillaryAmount    Decimal                @default(0) @db.Decimal(14, 2)
  tcoAmount          Decimal?               @db.Decimal(14, 2)
  offeredAt          DateTime?
  receivedAt         DateTime?
  deliveryDays       Int?
  validUntil         DateTime?
  warrantyMonths     Int?
  paymentTerms       String?
  deliveryTerms      String?
  inclusions         Json                   @default("[]")
  note               String?
  selected           Boolean                @default(false)
  selectedKey        String?                @unique
  supersedesOfferId  String?                @unique
  correctionReason   String?
  createdByAccountId String?
  createdAt          DateTime               @default(now())

  @@index([caseId, createdAt])
  @@index([partId])
  @@index([supersedesOfferId])
}

// Die Angebotsentscheidung ist ein eigener, append-only Fakt. Das alte
// Offer.selected bleibt ausschliesslich als Phase-7-Lesekompatibilitaet im
// Schema; neue Entscheidungen werden niemals durch Umschreiben des Angebots
// abgebildet.
model KontorProcurementOfferDecision {
  id                       String                 @id @default(cuid())
  caseId                   String
  case                     KontorProcurementCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  partId                   String?
  offerId                  String
  decision                 String                 @default("SELECTED")
  reason                   String
  alternativeReason        String?
  targetDeviationReason    String?
  comparisonSnapshot       Json
  targetSnapshot           Json
  decisionHash             String
  legacyReviewRequired     Boolean                @default(false)
  supersedesDecisionId     String?                @unique
  actorAccountId           String?
  actorLabel               String?
  createdAt                DateTime               @default(now())

  @@index([caseId, partId, createdAt])
  @@index([offerId])
  @@index([supersedesDecisionId])
}

// Originaldaten sind append-only. Neue Versionen verweisen auf den Ursprung;
// Zuordnungs- und Klassifikationsänderungen erzeugen neue Zeilen.
model KontorProcurementDocument {
  id                       String                       @id @default(cuid())
  caseId                   String
  case                     KontorProcurementCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  rootDocumentId           String?
  previousVersionId        String?
  version                  Int                          @default(1)
  kind                     String                       @default("OTHER")
  assignmentType           String?
  assignmentId             String?
  classificationState      String                       @default("REVIEW_REQUIRED")
  classificationSuggestion String?
  classificationConfidence Decimal?                     @db.Decimal(5, 2)
  classificationConfirmedBy String?
  fileName                 String
  mimeType                 String
  sizeInBytes              Int
  checksum                 String
  encryptedData            String
  encryptionKeyId          String?
  securityStatus           String                       @default("QUARANTINED")
  securityRevision         Int                          @default(1)
  scannerLeaseId           String?
  scannerLeaseRequestId    String?                      @unique
  scannerLeaseUntil        DateTime?
  scannerDeliveryAttempts  Int                          @default(0)
  mailMessageId            String?
  mailFrom                 String?
  mailTo                   Json                         @default("[]")
  mailSubject              String?
  mailSentAt               DateTime?
  mailHeadersHash          String?
  uploadedByAccountId      String?
  createdAt                DateTime                     @default(now())
  assignments              KontorProcurementDocumentAssignment[]
  securityScans            KontorProcurementDocumentScan[]
  securityDecisions        KontorProcurementDocumentSecurityDecision[]

  @@unique([caseId, checksum, version])
  @@unique([rootDocumentId, version])
  @@index([caseId, kind, createdAt])
  @@index([checksum])
  @@index([securityStatus, scannerLeaseUntil, createdAt])
}

model KontorProcurementDocumentScan {
  id                       String                       @id @default(cuid())
  documentId               String
  document                 KontorProcurementDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  attempt                  Int
  providerKey              String
  engineVersion            String?
  trustedAdapterDomain     String
  payloadHash              String
  contentChecksum          String
  verdict                  String
  signatureSet             String?
  resultHash               String
  details                  Json                         @default("{}")
  scannedAt                DateTime                     @default(now())

  @@unique([documentId, attempt])
  @@index([contentChecksum])
}

model KontorProcurementDocumentSecurityDecision {
  id                       String                       @id @default(cuid())
  documentId               String
  document                 KontorProcurementDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision                 Int
  decision                 String
  previousStatus           String
  newStatus                String
  scanId                   String?
  actorAccountId           String?
  actorLabel               String?
  reason                   String?
  metadata                 Json?
  createdAt                DateTime                     @default(now())

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

model KontorProcurementDocumentAssignment {
  id                       String                    @id @default(cuid())
  documentId               String
  document                 KontorProcurementDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision                 Int
  state                    String                    @default("REVIEW_REQUIRED")
  assignmentType           String?
  assignmentId             String?
  suggestion               String?
  confidence               Decimal?                 @db.Decimal(5, 2)
  note                     String?
  actorAccountId           String?
  createdAt                DateTime                  @default(now())

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

model KontorProcurementApproval {
  id                 String                 @id @default(cuid())
  caseId             String
  case               KontorProcurementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approverType       String
  approverId         String?
  approverLabel      String
  decision           String                 @default("PENDING")
  scope              String                 @default("FUNCTIONAL")
  scopeText          String
  approvedOfferId    String?
  approvedOfferSnapshot Json?
  priceCeiling       Decimal?               @db.Decimal(14, 2)
  conditions         Json                   @default("[]")
  quorumRequired     Int?
  quorumPresent      Int?
  votesFor           Int?
  votesAgainst       Int?
  votesAbstain       Int?
  protocolReference  String?
  resolutionType     String?
  supersedesApprovalId String?                 @unique
  revokedAt          DateTime?
