// =====================================================
// SYSTEM PRIVACY
// =====================================================
// Kleine allgemeine Datenschutz-Basis für Bonni Core.
// Umfangreiche DSGV-/Compliance-Automation bleibt ein Add-on.
// =====================================================

enum PrivacyRequestStatus {
  OPEN
  IN_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum ConsentRecordStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model PrivacySetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsentRecord {
  id        String              @id @default(cuid())
  subjectType String
  subjectId   String?
  accountId   String?

  consentKey  String
  consentText String?
  status      ConsentRecordStatus @default(ACTIVE)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?

  metadataJson Json?

  @@index([subjectType, subjectId])
  @@index([accountId])
  @@index([consentKey, status])
}

model PrivacyRequest {
  id          String               @id @default(cuid())
  requestType String
  status      PrivacyRequestStatus @default(OPEN)

  subjectType String
  subjectId   String?
  accountId   String?

  requestedByAccountId String?
  message              String?
  resultJson           Json?
  errorMessage         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([requestType, status])
  @@index([subjectType, subjectId])
  @@index([accountId])
}

model DataRetentionRule {
  id            String   @id @default(cuid())
  key           String   @unique
  target        String
  retentionDays Int
  active        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ProtectedDataDecision {
  ALLOWED
  DENIED
}

model ProtectedDataAccessGrant {
  id                 String   @id @default(cuid())
  tokenHash          String   @unique
  accountId          String
  moduleKey          String
  dataDomain         String
  purpose            String
  subjectId          String?
  challengeId        String?
  grantedByAccountId String?
  credentialRevision Int      @default(-1)
  providerId         String   @default("legacy")
  accessScope        String   @default("legacy")
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime @default(now())

  @@index([accountId, moduleKey, expiresAt])
  @@index([dataDomain, purpose])
  @@index([subjectId])
}

model ProtectedDataAccessLog {
  id          String                @id @default(cuid())
  accountId   String?
  moduleKey   String?
  dataDomain  String
  purpose     String
  operation   String
  subjectId   String?
  recordType  String?
  recordId    String?
  decision    ProtectedDataDecision
  reason      String?
  ipAddress   String?
  userAgent   String?
  metadataJson Json?
  createdAt   DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([moduleKey, dataDomain, createdAt])
  @@index([subjectId, createdAt])
  @@index([decision, createdAt])
}
