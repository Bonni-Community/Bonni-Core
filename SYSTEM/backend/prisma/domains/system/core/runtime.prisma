// =====================================================
// SYSTEM CORE: RUNTIME
// =====================================================
// Backend slot runtime state.
// Normalbetrieb: active + emergency run permanently; candidate starts only during updates; previous stays stopped but bootable.
// =====================================================


enum SystemRuntimeSlotRole {
  active
  candidate
  fallback
  emergency
  previous
  idle
  installer
}

enum SystemRuntimeSlotStatus {
  stopped
  starting
  healthy
  unhealthy
  active
  draining
  rollback_ready
  failed
}

model SystemRuntimeSlot {
  id                    String                  @id @default(cuid())

  key                   String                  @unique
  role                  SystemRuntimeSlotRole
  status                SystemRuntimeSlotStatus @default(stopped)

  versionId             String?
  version               SystemVersion?          @relation(fields: [versionId], references: [id])
  versionLabel          String?

  port                  Int?
  pid                   Int?
  healthUrl             String?
  artifactPath          String?

  receivesTraffic       Boolean                 @default(false)
  bootable              Boolean                 @default(true)
  protectedEmergency    Boolean                 @default(false)

  startedAt             DateTime?
  stoppedAt             DateTime?
  lastHealthAt          DateTime?
  lastEmergencyAccessAt DateTime?

  healthChecks          SystemHealthCheck[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([role])
  @@index([status])
  @@index([receivesTraffic])
  @@index([protectedEmergency])
}

// =====================================================
// LOCAL / CLOSED SYSTEM RUNTIME IDENTITY
// =====================================================
// Internal stateKey is used only for technical verification.
// Control Center should display this as System-Abgleich, not as State-Key.
// =====================================================

model SystemRuntimeIdentity {
  id            String   @id @default("singleton")
  createdAt     DateTime
  systemVersion String
  schemaVersion String
  userCount     Int
  stateKey      String
  updatedAt     DateTime @updatedAt
}

// =====================================================
// MODULE RUNTIME STATE
// =====================================================
// InstalledModule selbst liegt in system/module-registry.
// Hier wird nur gespeichert, ob ein installiertes Modul in einem Backend-Slot geladen wurde.
// =====================================================

enum ModuleRuntimeStatus {
  NOT_LOADED
  LOADING
  LOADED
  ERROR
  UNLOADED
}

model ModuleRuntimeState {
  id       String              @id @default(cuid())

  moduleId String
  module   InstalledModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  slotName String?
  status   ModuleRuntimeStatus @default(NOT_LOADED)

  loadedAt     DateTime?
  unloadedAt   DateTime?
  errorMessage String?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slotName])
  @@index([slotName])
  @@index([status])
}
enum ModuleNetworkExposure {
  DISABLED
  LOCAL
  INTERNAL
  PUBLIC
}

model ModuleNetworkPolicy {
  moduleKey          String                @id
  exposure           ModuleNetworkExposure @default(DISABLED)
  outboundEnabled    Boolean               @default(false)
  allowedHosts       Json                  @default("[]")
  allowedProtocols   Json                  @default("[]")
  requireTls         Boolean               @default(true)
  changedByAccountId String?
  changedAt          DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model ModuleNetworkObservation {
  id          String   @id @default(cuid())
  moduleKey   String
  direction   String
  protocol    String?
  remoteHost  String?
  remotePort  Int?
  route       String?
  decision    String
  reason      String?
  accountId   String?
  ipAddress   String?
  observedAt  DateTime @default(now())

  @@index([moduleKey, observedAt])
  @@index([decision, observedAt])
  @@index([remoteHost, observedAt])
}

enum DomainMessageStatus {
  PENDING
  DELIVERING
  DELIVERED
  REJECTED
  FAILED
  EXPIRED
}

// Core only transports and proves delivery. It never interprets app payloads.
// The payload is encrypted for the destination domain and removed after the
// configured retention period; payloadHash/correlationId remain as evidence.
model DomainMessage {
  id                   String              @id @default(cuid())
  correlationId        String
  idempotencyKey       String              @unique
  protocol             String
  sourceDomain         String
  targetDomain         String
  sourceRecordId       String?
  targetRecordId       String?
  payloadCiphertext    String?
  payloadHash          String
  status               DomainMessageStatus @default(PENDING)
  initiatedByAccountId String?
  expiresAt            DateTime
  deliveredAt          DateTime?
  rejectedAt           DateTime?
  failedAt             DateTime?
  lastErrorCode        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  attempts             DomainMessageAttempt[]

  @@index([correlationId, createdAt])
  @@index([sourceDomain, targetDomain, status])
  @@index([expiresAt, status])
}

model DomainMessageAttempt {
  id             String   @id @default(cuid())
  messageId      String
  message        DomainMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  decision       String
  resultCode     String?
  resultHash     String?
  remoteIdentity String?
  createdAt      DateTime @default(now())

  @@unique([messageId, attemptNumber])
  @@index([decision, createdAt])
}
