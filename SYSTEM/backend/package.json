{
  "name": "bonni-core-backend",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "maintenance:cleanup": "node scripts/maintenance/cleanup-stale-technical-data.mjs",
    "auth:ensure-jwt": "node scripts/auth/ensure-jwt-secret.mjs",
    "dev": "npm run maintenance:cleanup && npm run auth:ensure-jwt && tsx watch src/system/server/run-server.ts",
    "build": "npm run prisma:generate && npm run build:code",
    "build:code": "tsc && npm run seed:typecheck",
    "start": "npm run maintenance:cleanup && npm run auth:ensure-jwt && node dist/system/server/run-server.js",
    "seed": "prisma db seed",
    "admin:repair": "node scripts/auth/repair-bootstrap-admin.mjs",
    "seed:typecheck": "tsc -p tsconfig.seed.json",
    "prisma:validate": "prisma validate",
    "prisma:validate-isolated": "npm run prisma:assemble-modules && node scripts/database/validate-isolated-schemas.mjs",
    "prisma:assemble-modules": "node --import tsx scripts/modules/assemble-module-prisma.ts",
    "prisma:generate": "npm run prisma:assemble-modules && prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:compatibility": "node scripts/database/migrate-member-capability-key.mjs",
    "database:bootstrap": "npm run prisma:assemble-modules && node --import tsx scripts/database/bootstrap-isolated-databases.ts",
    "prisma:push": "npm run database:bootstrap",
    "prisma:studio": "prisma studio",
    "setup": "node scripts/setup/setup-system.mjs",
    "runtime:start": "bash scripts/runtime/start-runtime.sh .",
    "runtime:candidate": "bash scripts/runtime/start-candidate.sh .",
    "runtime:switch:candidate": "bash scripts/runtime/switch-proxy-to-candidate.sh .",
    "runtime:switch:active": "bash scripts/runtime/switch-proxy-to-active.sh .",
    "runtime:stop-old-active": "bash scripts/runtime/stop-old-active.sh .",
    "runcontainer:init": "node scripts/runcontainer/init-local-runcontainer.mjs",
    "runcontainer:verify": "node scripts/runcontainer/verify-local-runcontainer.mjs",
    "runcontainer:candidate": "node scripts/runcontainer/build-candidate-runcontainer.mjs",
    "runcontainer:promote": "node scripts/runcontainer/promote-candidate-runcontainer.mjs",
    "backup:restore-pending": "node scripts/backup/restore-pending.mjs",
    "dev:run": "npm run maintenance:cleanup && npm run auth:ensure-jwt && tsx watch src/system/server/run-server.ts",
    "redundant:dev": "npm run auth:ensure-jwt && tsx watch src/system/server/redundant-server.ts",
    "redundant:start": "npm run auth:ensure-jwt && node dist/system/server/redundant-server.js",
    "module-manager:dev": "tsx watch src/platform/module-manager/server/module-manager-server.ts",
    "module-manager:start": "node dist/platform/module-manager/server/module-manager-server.js",
    "test": "npm run build && node --import ./tests/test-env.mjs --test tests/*.test.mjs",
    "test:network-adapter": "npm run build && node --import ./tests/test-env.mjs --test tests/service-account-multi.test.mjs tests/data-adapter-registry.test.mjs",
    "test:system": "npm run build && node --import ./tests/test-env.mjs --test tests/service-account-multi.test.mjs tests/data-adapter-registry.test.mjs tests/module-compatibility.test.mjs tests/backup-validation.test.mjs tests/runtime-env.test.mjs tests/runtime-start-gate.test.mjs",
    "test:update-runner": "node --test tests/update-runner.test.mjs",
    "test:update-release": "npm run build && node --test tests/update-release-manifest.test.mjs",
    "release:key": "node scripts/update-release/generate-release-key.mjs",
    "release:create": "npm run build && node scripts/update-release/create-release.mjs",
    "modules:build": "node scripts/modules/build-module-packages.mjs ..",
    "modules:sync-installed-manifests": "node --import tsx scripts/modules/sync-installed-module-manifests.ts",
    "modules:sync-legal-payloads": "node --import tsx scripts/modules/sync-module-legal-payloads.ts",
    "modules:stage-runtime": "node --import tsx scripts/modules/stage-module-runtime-packages.ts",
    "modules:repair:kontorapp": "node --import tsx scripts/modules/repair-kontorapp-runtime.ts",
    "modules:verify": "node --import tsx scripts/modules/verify-module-packages.ts",
    "modules:integrate:prepare": "npm run database:bootstrap && npm run prisma:generate",
    "modules:integrate:finalize": "npm run modules:sync-installed-manifests && npm run modules:verify && npm run modules:sync-legal-payloads",
    "modules:integrate": "npm run modules:integrate:prepare && npm run modules:integrate:finalize"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.8.4",
    "pg": "^8.20.0",
    "prisma": "^6.19.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Bonni Core backend"
}
