# Einziger Pflichtwert für eine lokale Installation ohne Docker.
# Benutzer, Passwort, Host und Datenbanknamen an die eigene PostgreSQL-Instanz anpassen.
DATABASE_URL="postgresql://postgres:<POSTGRES-PASSWORT>@127.0.0.1:5432/bonni_core"

# MASTER_KEY, JWT_SECRET und MODULE_PRIVATE_DATA_SECRET werden bei `npm run setup`
# einmalig kryptografisch erzeugt und danach unverändert aus `.env` gelesen.

# Externe Zwei-Faktor-Provider werden als Bonni-Plugins installiert und
# ausschließlich in deren eigenem Einstellungsbereich konfiguriert.
