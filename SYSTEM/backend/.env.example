# Einziger Pflichtwert für eine lokale Installation ohne Docker.
# Benutzer, Passwort, Host und Datenbanknamen an die eigene PostgreSQL-Instanz anpassen.
DATABASE_URL="postgresql://postgres:<POSTGRES-PASSWORT>@127.0.0.1:5432/bonni_core"

# MASTER_KEY, JWT_SECRET und MODULE_PRIVATE_DATA_SECRET werden bei `npm run setup`
# einmalig kryptografisch erzeugt und danach unverändert aus `.env` gelesen.

# Externe Zwei-Faktor-Provider werden als Bonni-Plugins installiert und
# ausschließlich in deren eigenem Einstellungsbereich konfiguriert.

# Offizielle, signierte GitHub-Aktualisierungen. GitHub leitet diese feste URL
# immer auf das Manifest des neuesten veroeffentlichten stabilen Releases um.
BONNI_UPDATE_MANIFEST_URL="https://github.com/Bonni-Community/bonni-core/releases/latest/download/manifest.json"
BONNI_UPDATE_ALLOWED_ORIGINS="https://github.com,https://release-assets.githubusercontent.com"
BONNI_UPDATE_MAX_BYTES="2147483648"

# Optional: weitere eigene Core-Frontend-Adressen, wenn Frontend und Backend
# unterschiedliche Hosts verwenden. Kommagetrennte http(s)-Origins ohne Pfad;
# kein Sternchen. Lokale Adressen und derselbe Host funktionieren ohne Eintrag.
BONNI_ALLOWED_BROWSER_ORIGINS=""

# Optionale Matrix-Verwaltung: nur diese exakten Verwaltungs-Origins sind zulässig.
# Der Steuerungsschlüssel wird über die geschützte Core-Oberfläche hinterlegt.
# Der Matrix-Dienst läuft unabhängig und erhält keine Start-/Stopp-Kopplung an Core.
MATRIX_MANAGER_ALLOWED_ORIGINS="http://127.0.0.1:18090,http://localhost:18090,http://bonni-matrix-manager:18090"
