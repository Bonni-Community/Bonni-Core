upstream backend_runtime {
  server ${ACTIVE_BACKEND}:${ACTIVE_BACKEND_PORT} max_fails=2 fail_timeout=3s;
  server ${EMERGENCY_BACKEND}:${EMERGENCY_BACKEND_PORT} backup;
  keepalive 32;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  location = /runtime-proxy/status {
    add_header Content-Type application/json;
    add_header Access-Control-Expose-Headers "X-Runtime-Proxy,X-Runtime-Backend,X-Runtime-Upstream-Status" always;
    return 200 '{"ok":true,"mode":"runtime-proxy","active":"${ACTIVE_BACKEND}:${ACTIVE_BACKEND_PORT}","emergency":"${EMERGENCY_BACKEND}:${EMERGENCY_BACKEND_PORT}"}';
  }

  location = /runtime-proxy/active-health {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_pass http://${ACTIVE_BACKEND}:${ACTIVE_BACKEND_PORT}/api/health/ready;
  }

  location = /runtime-proxy/emergency-health {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_pass http://${EMERGENCY_BACKEND}:${EMERGENCY_BACKEND_PORT}/api/health/ready;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Runtime-Proxy "true";
    proxy_set_header Connection "";

    # Wenn active nicht erreichbar ist oder 502/503/504 liefert,
    # springt nginx auf backend-emergency als backup upstream.
    proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    add_header X-Runtime-Proxy "true" always;
    add_header X-Runtime-Backend $upstream_addr always;
    add_header X-Runtime-Upstream-Status $upstream_status always;
    add_header Access-Control-Expose-Headers "X-Runtime-Proxy,X-Runtime-Backend,X-Runtime-Upstream-Status" always;

    proxy_pass http://backend_runtime;
  }
}
