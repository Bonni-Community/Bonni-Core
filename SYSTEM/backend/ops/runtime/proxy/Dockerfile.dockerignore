# The proxy build needs exactly one nginx template. No source, environment,
# runtime storage, backup or key material is sent to its builder.
**
!SYSTEM/
!SYSTEM/backend/
!SYSTEM/backend/ops/
!SYSTEM/backend/ops/runtime/
!SYSTEM/backend/ops/runtime/nginx/
!SYSTEM/backend/ops/runtime/nginx/default.conf.template
!SYSTEM/backend/ops/runtime/proxy/
!SYSTEM/backend/ops/runtime/proxy/Dockerfile
!SYSTEM/backend/ops/runtime/proxy/Dockerfile.dockerignore
