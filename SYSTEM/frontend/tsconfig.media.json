{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "system/feature-modules/moduleMedia*.ts",
    "system/feature-modules/moduleMedia*.tsx"
  ]
}
